#!/usr/bin/env python3
"""project-manager — a CLI for a running FleetView instance.

Talks to FleetView's embedded HTTP API (the same one the web dashboard uses), so it works both
locally and over the network (e.g. Tailscale). Point it elsewhere with FLEETVIEW_URL, otherwise it
auto-discovers the local server via ~/.fleetview/web-port.

  project-manager peers                    find FleetView instances on this network
  project-manager -u <URL> <cmd>           run any command against another instance
  project-manager whoami [-p|--path|--id]  which terminal/project this agent is running in
  project-manager ls [-m] [-p P] [-g]      list every terminal + live status (-m marked, -g grouped)
  project-manager watch [-n SEC] [-m]      live-refreshing list
  project-manager show <sel> [-l N]        one terminal: status + recent output (conversation)
  project-manager tail <sel> [-l N]        recent output only
  project-manager send <sel> <text...>     inject a prompt, submit it, confirm it left the input box
                                           (-N types it without Enter)
  project-manager key  <sel> <key>         send a key: esc enter up down left right tab bspace c-c ...
  project-manager choose <sel> <n>         answer a menu: send digit <n> then Enter
  project-manager check [<sel>]            flag conversations that look error-terminated / stuck
  project-manager ask <sel> <question…>    "BTW" side-query: ask the agent using its context WITHOUT
                                           interrupting its live session (forked, throwaway answer)
  project-manager log <sel> [-f|-c|-p]     locate the agent's conversation-history file (Claude/Codex)
  project-manager new <project-sel>        open a new terminal in a board project (--claude, -c CMD)
  project-manager subagent <task...>       open an agent terminal and deliver it a task (--codex, --id)
  project-manager rename <sel> <name...>   relabel a terminal
  project-manager rm <sel>                 remove a terminal (kills its session)
  project-manager restore <session-id>     bring a conversation back: its card (the one it was in, or a
                                           new one) and the agent resumed in it (--no-wait)
  project-manager open <folder> [--claude] put a ~/PycharmProjects folder on the board
  project-manager notes [-f Q] [-p]        the shared Notes list (the web's quick-command chips)
  project-manager notes add <text...>      append a note
  project-manager notes rm <note-sel>      delete a note (prints it back, so you can re-add it)

History of the conversations (Claude + Codex) on this Mac — or, with -u, on that one:
  project-manager projects                 L0  projects by last activity
  project-manager history [<project>]      L1  a project's conversations + transcript paths
  project-manager session <id>             L2  one conversation, one line per turn
  project-manager session <id> -t N        L3  one turn in full
  project-manager search <words…>          which conversations mention something
  project-manager session <id> --files     the files a conversation wrote/edited/read
  project-manager memory [<project>]       notes earlier agents left about a project
  project-manager cat <path>               a file or folder — on the -u machine, where history points

<sel> matches a terminal by name substring (case-insensitive) or id prefix.
<id> (session) is a conversation: a session-id prefix, a FleetView card id, or a transcript path.
<note-sel> matches a note by its number in `notes`, its id prefix, or a text substring.
"""
import argparse, json, os, re, subprocess, sys, time, urllib.parse, urllib.request

HOME = os.path.expanduser("~")

def base_url():
    env = os.environ.get("FLEETVIEW_URL")
    if env:
        return env.rstrip("/")
    try:
        with open(os.path.join(HOME, ".fleetview", "web-port")) as f:
            return "http://127.0.0.1:%s" % f.read().strip()
    except OSError:
        return "http://127.0.0.1:8080"

BASE = base_url()          # rebound by --url before any command runs

# Identify ourselves so the audit log attributes these calls to the CLI rather than to an
# anonymous browser on the LAN.
UA = "fleetctl/project-manager/1.0"
# The fleet runs permission-bypassed by convention; `new --claude` exists so that is one
# explicit flag rather than a string every caller retypes (and sometimes mistypes).
CLAUDE_CMD = "claude --dangerously-skip-permissions"
# Codex's equivalent. Separate constant rather than a flag on the Claude one: the two CLIs spell
# "skip the prompts" differently and neither accepts the other's wording.
CODEX_CMD = "codex --dangerously-bypass-approvals-and-sandbox"


def _get(path, timeout=10, base=None):
    req = urllib.request.Request((base or BASE) + path, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")

def local_base():
    """This Mac's own FleetView, whatever -u or FLEETVIEW_URL point at."""
    try:
        with open(os.path.join(HOME, ".fleetview", "web-port")) as f:
            return "http://127.0.0.1:%s" % f.read().strip()
    except OSError:
        return "http://127.0.0.1:8080"

def is_remote():
    """Whether BASE is another machine. Only loopback counts as here: this Mac's own LAN address
    also reaches this Mac, but going through the server for it costs nothing and is still right."""
    return (urllib.parse.urlparse(BASE).hostname or "") not in ("127.0.0.1", "localhost", "::1")

# Set when FleetView runs this script on behalf of another machine (GET /pm): the output goes back
# over the network, so colour follows the caller's terminal rather than this process's pipe, and
# every "next: project-manager …" hint names the instance the caller has to aim at to follow it.
SERVED = os.environ.get("FV_PM_SERVED") == "1"
PM = "project-manager"
if SERVED and os.environ.get("FV_PM_ORIGIN"):
    PM = "project-manager -u %s" % os.environ["FV_PM_ORIGIN"]

def _cmd(s):
    """A hint's command line, aimed at the instance the output came from."""
    return s.replace("project-manager ", PM + " ") if PM != "project-manager" else s

def api_json(path):
    try:
        return json.loads(_get(path))
    except urllib.error.URLError as e:
        sys.exit("cannot reach FleetView at %s (%s). Is it running? Set FLEETVIEW_URL to override." % (BASE, e))

def api_text(path):
    try:
        return _get(path)
    except urllib.error.URLError as e:
        sys.exit("cannot reach FleetView at %s (%s)." % (BASE, e))

# ---- running a command on the machine it is about ----
#
# The history commands, `log` and `cat` read files: transcripts, the search index, memory notes.
# Answered here they would describe this Mac under another machine's name, so against another
# instance they run *there* — FleetView's GET /pm starts this same script on that machine and hands
# back what it printed. Same code, that machine's files: the output is identical to running it there.

# What /pm will run. FleetView keeps its own copy of this list (PMRunner.commands) and refuses the
# rest: everything else here already goes through the HTTP API and has no reason to be run remotely.
REMOTE_RUN = ("projects", "history", "session", "search", "memory", "log", "cat")

def pm_remote(argv, timeout=300):
    """Run `project-manager <argv>` on the -u instance: (exit code, stdout, stderr)."""
    q = urllib.parse.urlencode({"argv": json.dumps(argv), "color": "1" if TTY else "0",
                                "origin": BASE}, quote_via=urllib.parse.quote)
    try:
        r = json.loads(_get("/pm?" + q, timeout=timeout))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            sys.exit("%s is a FleetView too old to run %s remotely (no /pm) — update it there"
                     % (BASE, argv[0]))
        body = e.read().decode("utf-8", "replace").strip()
        try:
            r = json.loads(body)
        except ValueError:
            sys.exit("%s refused %s: %s" % (BASE, argv[0], body or e))
        sys.exit("%s: %s" % (BASE, (r.get("stderr") or str(e)).strip()))
    except urllib.error.URLError as e:
        sys.exit("cannot reach FleetView at %s (%s)." % (BASE, e))
    except ValueError:
        sys.exit("%s answered /pm with something that is not JSON" % BASE)
    return r.get("code", 1), r.get("stdout", ""), r.get("stderr", "")

def forward(argv):
    code, out, err = pm_remote(argv)
    sys.stdout.write(out)
    sys.stderr.write(err)
    sys.exit(code)

def _sub_argv(argv):
    """The command line from the subcommand on — what the other machine should run. Only -u/--url
    sits in front of it, and that is the one thing it must not see: aimed at itself it would loop."""
    i = 0
    while i < len(argv):
        t = argv[i]
        if t in ("-u", "--url"):
            i += 2
        elif t.startswith("--url=") or (t.startswith("-u") and len(t) > 2):
            i += 1
        else:
            return argv[i:]
    return []

# ---- colors ----
TTY = os.environ.get("FV_PM_COLOR") == "1" if SERVED else sys.stdout.isatty()
def c(code, s):
    return "\033[%sm%s\033[0m" % (code, s) if TTY else s
STATUS_COLOR = {"working": "32", "needsYou": "33", "idle": "90", "shell": "36", "exited": "31", "closed": "90"}
def dot(status):
    return c(STATUS_COLOR.get(status, "0"), "●")

def mark(t):
    """The card's mark flag. Still called `done` on the wire — renaming it would drop the marks
    already saved in ~/.fleetview/state.json."""
    return c("32", "✓") if t.get("done") else " "

def short_tokens(n):
    if n < 1000: return str(n)
    if n < 1_000_000: return "%.1fk" % (n / 1000)
    return "%.1fM" % (n / 1_000_000)

def short_bytes(n):
    for u in ("B", "K", "M", "G"):
        if n < 1024: return "%d%s" % (n, u)
        n //= 1024
    return "%dT" % n

def ago(sec):
    if sec is None or sec < 0: return "-"
    if sec < 60: return "%ds" % sec
    if sec < 3600: return "%dm" % (sec // 60)
    if sec < 86400: return "%dh" % (sec // 3600)
    return "%dd" % (sec // 86400)

def state():
    return api_json("/state")

def proj_name(st, pid):
    for p in st["projects"]:
        if p["id"] == pid: return p["name"]
    return "?"

def match_projects(st, sel):
    """Projects matching `sel` by exact name, name substring, or id prefix (case-insensitive).

    An exact name wins outright, so `-p fancy_web` means that project and not also
    `qwen_fancy_web` — substring matching alone makes a short name unable to address itself.
    """
    sl = sel.lower()
    exact = [p for p in st["projects"] if p["name"].lower() == sl]
    if exact:
        return exact
    return [p for p in st["projects"] if sl in p["name"].lower() or p["id"].lower().startswith(sl)]

def cluster_name(st, cid):
    if not cid: return ""
    for cl in st.get("clusters", []):
        if cl["id"] == cid: return cl["name"]
    return "?"

def resolve(st, sel):
    """Find one terminal by id-prefix or name substring; exit with matches if ambiguous."""
    sl = sel.lower()
    exact = [t for t in st["terminals"] if t["id"].lower() == sl or t["name"].lower() == sl]
    if len(exact) == 1: return exact[0]
    hits = [t for t in st["terminals"] if t["id"].lower().startswith(sl) or sl in t["name"].lower()]
    if len(hits) == 1: return hits[0]
    if not hits:
        sys.exit("no terminal matches %r" % sel)
    print("ambiguous %r — matches:" % sel, file=sys.stderr)
    for t in hits:
        print("  %s  %s" % (t["id"][:8], t["name"]), file=sys.stderr)
    sys.exit(2)

def resolve_note(notes, sel):
    """Find one note by its 1-based number in `notes`, id prefix, or text substring.

    The number is the one `notes` printed, which is why the listing numbers against the *full*
    list even when filtered — a number you can see has to stay a selector you can use.
    """
    sl = sel.lower()
    if sl.isdigit() and 1 <= int(sl) <= len(notes):
        return notes[int(sl) - 1]
    hits = [n for n in notes if n["id"].lower().startswith(sl)]
    if len(hits) != 1:
        hits = [n for n in notes if sl in n["text"].lower()]
    if len(hits) == 1: return hits[0]
    if not hits:
        sys.exit("no note matches %r" % sel)
    print("ambiguous %r — matches:" % sel, file=sys.stderr)
    for n in hits:
        print("  %s  %s" % (n["id"][:8].lower(), n["text"].splitlines()[0][:60]), file=sys.stderr)
    sys.exit(2)

# ---- commands ----
def cmd_peers(a):
    """Find the other FleetView instances on this network.

    There is no announcement to listen for, so this probes: every address on the local /24, on the
    ports FleetView picks from (8080 upward — it takes the next free one, so a machine that had a
    port taken is not on 8080). Answering /state with the right shape is the identification; nothing
    else on these ports would.
    """
    import concurrent.futures
    import socket as _socket

    import ipaddress

    def own_nets():
        """Our IPv4 addresses with the subnet each actually belongs to.

        The netmask matters and used to be assumed: chopping the last octet off our address and
        sweeping .1-.254 is a /24, and on anything wider it is wrong in a way that looks like
        success. On a 255.255.248.0 network — a /21, eight /24s joined — it probes an eighth of the
        addresses, misses even the gateway, and prints "no FleetView instances found".

        `ifconfig` reports the mask as a hex word (netmask 0xfffff800), which is why this parses
        rather than calling `ipconfig getifaddr`, which only ever returns the address.
        """
        ips, nets = set(), []
        try:
            out = subprocess.run(["ifconfig"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            return ips, nets
        for line in out.splitlines():
            f = line.split()
            if len(f) < 4 or f[0] != "inet" or "netmask" not in f:
                continue
            ip = f[1]
            mask = f[f.index("netmask") + 1]
            if ip.startswith(("127.", "169.254.")):
                continue
            ips.add(ip)
            try:
                bits = bin(int(mask, 16)).count("1") if mask.startswith("0x") else None
                net = ipaddress.IPv4Network(f"{ip}/{bits if bits is not None else mask}",
                                            strict=False)
            except ValueError:
                continue
            # /31 and /32 are point-to-point and tunnel interfaces: one address, no subnet to walk.
            # Tailscale is the one that matters, and it is reached by asking it (see tailnet_hosts).
            if net.prefixlen >= 31:
                continue
            if net not in nets:
                nets.append(net)
        return ips, nets

    def tailnet_hosts():
        """Every IPv4 on this tailnet, from Tailscale itself.

        A tailnet cannot be swept: the interface carries a /32 — one address, no subnet — and the
        range it sits in, 100.64.0.0/10, is four million addresses. This is why a Tailscale machine
        never appeared in the scan; there was nothing for a subnet sweep to find. The node already
        knows its peers by name and address, so ask instead of look. Offline peers are skipped so
        the probe does not spend its timeout on machines known to be down.
        """
        for binary in ("/usr/local/bin/tailscale", "/opt/homebrew/bin/tailscale",
                       "/Applications/Tailscale.app/Contents/MacOS/Tailscale"):
            if not os.access(binary, os.X_OK):
                continue
            try:
                out = subprocess.run([binary, "status", "--json"],
                                     capture_output=True, text=True, timeout=10).stdout
                st = json.loads(out)
            except (OSError, subprocess.SubprocessError, ValueError):
                return []
            hosts = []
            for node, skip_offline in [(st.get("Self") or {}, False)] + \
                                      [(v, True) for v in (st.get("Peer") or {}).values()]:
                if skip_offline and not node.get("Online"):
                    continue
                hosts += [i for i in (node.get("TailscaleIPs") or []) if ":" not in i]
            return hosts
        return []

    def owner(d):
        """The macOS account a peer runs as, inferred from any absolute path it reports.

        /state has no user field, but every project path, terminal cwd and transcript path lives
        under /Users/<name>. So this is inference, not a lookup: an instance with no projects and
        no terminals reports no path at all and comes back "-" — which is the honest answer, and
        the reason this is not presented as something the API tells us.
        """
        paths = [p.get("path") or "" for p in d.get("projects", [])]
        for t in d.get("terminals", []):
            paths += [t.get("cwd") or "", t.get("transcript") or ""]
        names = set()
        for p in paths:
            m = re.match(r"/Users/([^/]+)/", p)
            if m and m.group(1) != "Shared":   # /Users/Shared is nobody's account
                names.add(m.group(1))
        return "/".join(sorted(names)) or "-"

    HOST_CAP = 4096   # above this, fall back to the /24 we sit in — a /16 is not a scan you wait for

    mine, nets = own_nets()
    if not mine or not nets:
        sys.exit("no usable IPv4 subnet on any interface — not on a network?")
    hosts, narrowed = [], False
    for net in nets:
        use = net
        if net.num_addresses > HOST_CAP:
            narrowed = True
            inside = [i for i in mine if ipaddress.IPv4Address(i) in net]
            if not inside:
                continue
            use = ipaddress.IPv4Network(inside[0] + "/24", strict=False)
        hosts += [str(h) for h in use.hosts()]
    tailnet = tailnet_hosts()
    hosts += tailnet
    hosts = sorted(set(hosts), key=lambda s: tuple(int(x) for x in s.split(".")))
    ports = [int(p) for p in (a.ports or "8080,8081,8082").split(",")]

    def probe(target):
        host, port, timeout = target
        try:
            req = urllib.request.Request("http://%s:%d/state" % (host, port),
                                         headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=timeout) as r:
                d = json.loads(r.read().decode("utf-8", "replace"))
            if not isinstance(d, dict) or "terminals" not in d or "projects" not in d:
                return None
            return (host, port, d)
        except Exception:
            return None

    # A LAN probe is multiplied by every address in the subnet and has to stay short. A tailnet hop
    # is not the same animal: ~700ms round trip, and /state has been measured coming back in 2.0s
    # from a machine that was up the whole time. At the LAN timeout it never answered in time, and a
    # timeout is indistinguishable from "not running FleetView" — which is why tailnet machines
    # looked absent. There are only a handful of them, so the wait is affordable where it is needed.
    slow = set(tailnet)
    tail_timeout = max(8.0, a.timeout * 4)
    targets = [(h, p, tail_timeout if h in slow else a.timeout) for h in hosts for p in ports]
    scope = ", ".join(str(n) for n in nets)
    if tailnet:
        scope += " + %d tailnet node%s" % (len(tailnet), "" if len(tailnet) == 1 else "s")
    if narrowed:
        # Never silent: a sweep that covered a slice of a large network would otherwise let
        # "none found" be read as "none there".
        scope += "  (too large — only the local /24 of it was scanned)"
    sys.stderr.write("scanning %d addresses on %s\n" % (len(hosts), scope))
    found = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=a.jobs) as ex:
        for r in ex.map(probe, targets):
            if r:
                found.append(r)
    if not found:
        print("no FleetView instances found on %s" % scope)
        return
    found.sort(key=lambda r: (r[0], r[1]))
    print("%-22s %-12s %-5s %-9s %s" % ("URL", "USER", "TERMS", "WORKING", "PROJECTS"))
    for host, port, d in found:
        terms = d.get("terminals", [])
        working = sum(1 for t in terms if t.get("status") == "working")
        projects = ", ".join(p.get("name", "") for p in d.get("projects", []))[:36]
        self_mark = c("32", " ←self") if host in mine else ""
        print("%-22s %-12s %-5d %-9d %s%s" % ("http://%s:%d" % (host, port), owner(d)[:12],
                                              len(terms), working, projects, self_mark))
    print(c("90", "\nuse:  project-manager -u <URL> ls        (or FLEETVIEW_URL=<URL>)"))


def _ls_head(w, pw):
    cells = ["%-8s  " % "ID", "%-1s" % "M", "%-*s" % (w, "NAME"), "%-12s" % "CLUSTER"]
    if pw:
        cells.append("%-*s" % (pw, "PROJECT"))
    cells += ["%-5s" % "AGENT", "%5s" % "IDLE", "%7s" % "TOKENS", " STATUS/PROMPT"]
    return " ".join(cells)


def _ls_line(st, t, w, pw):
    """One packed row. pw=0 drops the PROJECT column; otherwise it is sized to the widest name
    actually on screen rather than a fixed 12, because a truncated project name is one you cannot
    grep for — `Benchmark_COWORK` used to print as `Benchmark_CO`, so filtering this table by the
    name you know silently matched nothing. `-p` exists so you need not grep it at all.
    """
    cells = ["%-8s" % t["id"][:8].lower(), dot(t["status"]), mark(t),
             "%-*s" % (w, t["name"][:w]),
             "%-12s" % (cluster_name(st, t.get("clusterId")) or "-")[:12]]
    if pw:
        cells.append("%-*s" % (pw, proj_name(st, t["projectId"])[:pw]))
    cells += ["%-5s" % (t.get("agent") or "-")[:5], "%5s" % ago(t.get("idle")),
              "%7s" % short_tokens(t.get("tokens", 0)),
              " " + c(STATUS_COLOR.get(t["status"], "0"), t["statusLabel"]) + "  "
              + (t.get("prompt") or "").replace("\n", " ")[:50]]
    return " ".join(cells)


def cmd_ls(a):
    st = state()
    rows = st["terminals"]
    sel = getattr(a, "project", None)
    if sel:
        ps = match_projects(st, sel)
        if not ps:
            sys.exit("no project matches %r (project-manager ls -g lists them)" % sel)
        keep = {p["id"] for p in ps}
        rows = [t for t in rows if t.get("projectId") in keep]
        if not rows:
            # Not an exit: under `watch` an empty project should keep refreshing, not end the loop.
            print("no terminals in %s" % ", ".join(p["name"] for p in ps)); return
    # `done` is the wire name of the mark flag (kept so existing saved marks still load).
    if getattr(a, "marked", False):
        rows = [t for t in rows if t.get("done")]
        if not rows:
            print("no marked terminals"); return
        # Few rows in -m, so show full detail (untruncated project + cwd) rather than the packed table.
        for t in rows:
            cl = cluster_name(st, t.get("clusterId"))
            last = (t.get("prompt") or "").replace("\n", " ")[:70]
            print("%s %s %s   [%s]  %s" % (
                dot(t["status"]), c("32", "✓"), c("1", t["name"]),
                c(STATUS_COLOR.get(t["status"], "0"), t["statusLabel"]), c("90", t["id"][:8].lower())))
            print("    project: %s%s" % (proj_name(st, t["projectId"]), ("   cluster: " + cl) if cl else ""))
            print("    cwd: %s" % t.get("cwd", "?"))
            print("    agent=%s  idle=%s  tokens=%s" % (
                t.get("agent") or "-", ago(t.get("idle")), short_tokens(t.get("tokens", 0))))
            if last:
                print("    %s %s" % (c("90", "last:"), last))
            print()
        return
    if not rows:
        print("no terminals"); return
    w = min(26, max((len(t["name"]) for t in rows), default=4))
    if getattr(a, "group", False):
        # The heading carries the project, so the column would only repeat it.
        groups = {}
        for t in rows:
            groups.setdefault(proj_name(st, t["projectId"]), []).append(t)
        print(_ls_head(w, 0))
        for i, pn in enumerate(sorted(groups, key=str.lower)):
            g = groups[pn]
            live = sum(1 for t in g if t["status"] != "closed")
            print("%s%s %s" % ("\n" if i else "", c("1", pn),
                               c("90", "(%d, %d live)" % (len(g), live))))
            for t in g:
                print(_ls_line(st, t, w, 0))
    else:
        pw = min(20, max((len(proj_name(st, t["projectId"])) for t in rows), default=7))
        print(_ls_head(w, pw))
        for t in rows:
            print(_ls_line(st, t, w, pw))
    n = sum(1 for t in st["terminals"] if t.get("done"))
    if n and not getattr(a, "marked", False):
        print(c("90", "%d marked (project-manager ls -m)" % n))

def _self_term_id():
    """The terminal this process is running inside, or None.

    `FLEETVIEW_TERM_ID` is exported by FleetView when it creates the terminal
    (TerminalWindowController) and is the same handle every status hook reports under, so it is the
    authoritative answer. The tmux session name is the fallback for a shell started outside that
    environment — RemoteServer names sessions `fv_<uuid without dashes>`.
    """
    tid = os.environ.get("FLEETVIEW_TERM_ID")
    if tid:
        return tid
    try:
        name = subprocess.check_output(["tmux", "display-message", "-p", "#{session_name}"],
                                       stderr=subprocess.DEVNULL, text=True).strip()
    except Exception:
        return None
    return name[3:] if name.startswith("fv_") else None


def my_card():
    """(state, my terminal, its project) from THIS Mac's FleetView, or None outside a card.

    Always the local instance, whatever -u says: the card an agent runs on lives on the machine the
    agent runs on. Asking the -u instance instead is how `whoami` used to answer "wrong instance?"
    to every caller aiming at another Mac.
    """
    tid = _self_term_id()
    if not tid:
        return None
    try:
        st = json.loads(_get("/state", base=local_base()))
    except (OSError, ValueError):     # URLError and a 3.9 socket.timeout are both OSErrors
        return None
    key = tid.replace("-", "").lower()
    me = next((t for t in st["terminals"] if t["id"].replace("-", "").lower() == key), None)
    if not me:
        return None
    return st, me, next((q for q in st["projects"] if q["id"] == me.get("projectId")), None)


def own_project_name():
    """The caller's project by name — its card's project, else the folder it stands in — for a
    command run on another machine, where "your project" can only mean the one called the same."""
    mine = my_card()
    if mine and mine[2]:
        return mine[2]["name"]
    try:
        top = subprocess.check_output(["git", "rev-parse", "--show-toplevel"],
                                      stderr=subprocess.DEVNULL, text=True).strip()
    except Exception:
        top = ""
    return os.path.basename(top or os.getcwd())


def cmd_whoami(a):
    """Which card is this agent on? Run from inside a FleetView terminal.

    A live query rather than an environment variable FleetView could have exported, because a
    terminal can be dragged into another project — that changes the answer without restarting the
    shell, so anything baked in at launch goes stale silently.
    """
    tid = _self_term_id()
    if not tid:
        sys.exit("not inside a FleetView terminal (no FLEETVIEW_TERM_ID, no fv_* tmux session)")
    mine = my_card()
    if not mine:
        sys.exit("terminal %s is not on this Mac's FleetView (%s) — is it running?"
                 % (tid[:8].lower(), local_base()))
    st, me, p = mine
    if a.project_only:
        print(p["name"] if p else ""); return
    if a.path_only:
        print(p["path"] if p else ""); return
    if a.id_only:
        print(me["id"][:8].lower()); return
    cl = cluster_name(st, me.get("clusterId"))
    print("%s %s   [%s]  %s" % (
        dot(me["status"]), c("1", me["name"]),
        c(STATUS_COLOR.get(me["status"], "0"), me["statusLabel"]), c("90", me["id"][:8].lower())))
    print("    project: %s%s" % (p["name"] if p else "?", ("   cluster: " + cl) if cl else ""))
    if p:
        print("    path:    %s" % p["path"])
    print("    cwd:     %s" % me.get("cwd", "?"))
    print("    agent=%s  tokens=%s" % (me.get("agent") or "-", short_tokens(me.get("tokens", 0))))


def cmd_watch(a):
    try:
        while True:
            sys.stdout.write("\033[2J\033[H" if TTY else "\n")
            print("FleetView @ %s   %s" % (BASE, time.strftime("%H:%M:%S")))
            cmd_ls(a)
            time.sleep(a.n)
    except KeyboardInterrupt:
        pass

def _recent(tid, n):
    """The last `n` lines of a pane that have something on them. A TUI's screen ends in rows of
    padding under its composer, so a plain capture of the last 3 lines was 3 blank ones."""
    text = api_text("/capture?id=%s&lines=%d" % (tid, n + 80))
    lines = text.rstrip().split("\n")
    return "\n".join(lines[-n:]) + "\n" if lines and lines != [""] else ""

def cmd_tail(a):
    t = resolve(state(), a.sel)
    sys.stdout.write(_recent(t["id"], a.lines))

def cmd_show(a):
    st = state(); t = resolve(st, a.sel)
    print("%s %s%s   [%s]  agent=%s  tokens=%s  last activity=%s ago" % (
        dot(t["status"]), c("1", t["name"]), c("32", "  ✓ marked") if t.get("done") else "",
        c(STATUS_COLOR.get(t["status"], "0"), t["statusLabel"]),
        t.get("agent") or "-", short_tokens(t.get("tokens", 0)), ago(t.get("idle"))))
    cl = cluster_name(st, t.get("clusterId"))
    print("project: %s%s   id: %s" % (proj_name(st, t["projectId"]), ("   cluster: " + cl) if cl else "", t["id"]))
    print("cwd: %s" % t.get("cwd", "?"))
    tp = t.get("transcript")
    print("transcript: %s" % (tp if tp else c("90", "(none yet — interact once to capture)")))
    print(c("90", "-" * 60))
    sys.stdout.write(_recent(t["id"], a.lines))

# ---- getting a prompt to actually submit ----
#
# Text followed at once by Enter reads to Codex as a paste with a Return inside it, and its
# paste-burst guard turns that Return into a newline: the prompt sits in the composer looking sent.
# FleetView now leaves a gap, checks the composer and presses Enter again (Remote/Submit.swift), and
# answers `/type?wait=1` with what happened. These helpers mirror that check for a FleetView that
# predates it — a peer on another Mac is often a version behind.

PROMPT_MARKS = ("›", "❯")    # Codex ›, Claude ❯

def _squeeze(s):
    """Text with spaces, line breaks and box edges removed — what survives a TUI re-wrapping it."""
    return re.sub(r"[\s│]+", "", s)

def _probe(text):
    """The tail of the text (a long prompt scrolls in Claude's composer, keeping the end in view);
    None when there is too little to recognise — a menu digit is on screen in every menu."""
    s = _squeeze(text)
    return s[-12:] if len(s) >= 3 else None

def _is_marker(line):
    t = line.lstrip(" │")
    return t[:1] in PROMPT_MARKS or t.startswith("> ")

def _composer_holds(pane, probe):
    """Whether the composer — the LAST prompt-marker line and what follows — still holds the text.
    Earlier marker lines are history: both agents keep a submitted prompt on screen under its marker,
    which is how an earlier version of this check read a long-finished task as forever pending."""
    lines = pane.split("\n")
    marks = [i for i, ln in enumerate(lines) if _is_marker(ln)]
    if not marks:
        return False
    region = "\n".join(lines[marks[-1]:])
    if "[Pasted text" in region or "[Pasted Content" in region:
        return True
    return probe in _squeeze(region)

def _type(tid, text, enter=True):
    """Type into a terminal and return the server's verdict — submitted / stuck / sent / typed /
    superseded — or None from a FleetView too old to give one (it ignores `wait`)."""
    # quote_via=quote so spaces become %20 (not "+", which the server won't turn back into a space)
    q = urllib.parse.urlencode({"id": tid, "text": text, "enter": "1" if enter else "0",
                                "wait": "1"}, quote_via=urllib.parse.quote)
    return api_json("/type?" + q).get("submit")

def _confirm_submit(t, text, tries=4):
    """The server's check, done from here. True submitted, False stuck, None not checkable.

    Only for agents: in a shell running a command, a second Enter answers whatever that command is
    waiting on, and a `❯` shell prompt would pass for a composer.
    """
    probe = _probe(text)
    if probe is None or not t.get("agent"):
        return None
    for i in range(tries + 1):
        time.sleep(0.5 if i == 0 else 0.7)
        if not _composer_holds(api_text("/capture?id=%s&lines=60" % t["id"]), probe):
            return True
        if i == tries:
            break
        api_json("/key?" + urllib.parse.urlencode({"id": t["id"], "k": "Enter"}))
    return False

def cmd_send(a):
    t = resolve(state(), a.sel)
    text = " ".join(a.text)
    verdict = _type(t["id"], text, enter=not a.no_enter)
    if a.no_enter:
        print("typed into %s (no enter)" % t["name"]); return
    if verdict is None:
        ok = _confirm_submit(t, text)
        verdict = {True: "submitted", False: "stuck", None: "sent"}[ok]
    if verdict == "stuck":
        # Exit non-zero: `send … && next-step` must not carry on as if the agent got the prompt.
        sys.exit("typed into %s but it did NOT submit — the text is still in its input box.\n"
                 "press Enter with: project-manager key %s enter" % (t["name"], t["id"][:8].lower()))
    note = {"submitted": "submitted",
            "sent": "Enter pressed, not verified",
            "superseded": "another input reached it before this one could be confirmed"}
    print("sent to %s — %s" % (t["name"], note.get(verdict, verdict)))

def cmd_key(a):
    t = resolve(state(), a.sel)
    aliases = {"esc": "Escape", "enter": "Enter", "up": "Up", "down": "Down", "left": "Left",
               "right": "Right", "tab": "Tab", "space": "Space", "bs": "BSpace", "bspace": "BSpace",
               "c-c": "C-c", "^c": "C-c", "c-d": "C-d", "c-l": "C-l"}
    k = aliases.get(a.key.lower(), a.key)
    api_json("/key?" + urllib.parse.urlencode({"id": t["id"], "k": k}))
    print("key %s -> %s" % (k, t["name"]))

def cmd_choose(a):
    t = resolve(state(), a.sel)
    api_json("/type?" + urllib.parse.urlencode({"id": t["id"], "text": str(a.n), "enter": "1"}))
    print("chose option %s in %s" % (a.n, t["name"]))

ERR_PATTERNS = [
    r"API Error", r"overloaded", r"rate limit", r"quota", r"\b429\b", r"\b529\b",
    r"Internal Server Error", r"\b5\d\d\b error", r"ECONNRESET", r"ETIMEDOUT",
    r"Traceback \(most recent", r"^panic:", r"fatal error", r"Killed: 9", r"signal: killed",
    r"Invalid API key", r"Please run /login", r"session limit", r"usage limit", r"context left until",
    r"Execution error", r"Request timed out", r"connection error",
]  # deliberately NOT "Killed"/"keyboard interrupt" — a Ctrl-C is user-initiated, not an error
ERR_RE = re.compile("|".join(ERR_PATTERNS), re.IGNORECASE | re.MULTILINE)

def check_one(st, t):
    verdict, evidence = "ok", ""
    if t["status"] == "exited":
        verdict, evidence = "exited", "process ended"
    text = api_text("/capture?id=%s&lines=%d" % (t["id"], 120))
    for line in reversed(text.splitlines()):
        if ERR_RE.search(line):
            verdict = "exited" if verdict == "exited" else "error"
            evidence = line.strip()[:100]
            break
    return verdict, evidence

def cmd_check(a):
    st = state()
    targets = [resolve(st, a.sel)] if a.sel else st["terminals"]
    flagged = 0
    for t in targets:
        if not t.get("canOpen") and t["status"] != "exited":
            continue  # no live session to inspect
        verdict, evidence = check_one(st, t)
        if verdict == "ok":
            if a.sel: print("%s %s: ok" % (dot(t["status"]), t["name"]))
            continue
        flagged += 1
        col = "31" if verdict in ("error", "exited") else "33"
        print("%s %-24s %s  %s" % (dot(t["status"]), t["name"][:24], c(col, verdict.upper()), c("90", evidence)))
    if not a.sel:
        print(c("90", "\n%d flagged / %d terminals" % (flagged, len(targets))))

def cmd_ask(a):
    t = resolve(state(), a.sel)
    q = " ".join(a.text)
    url = BASE + "/ask?" + urllib.parse.urlencode({"id": t["id"], "q": q}, quote_via=urllib.parse.quote)
    print(c("90", "asking %s (forked side-query, live session untouched)…" % t["name"]))
    try:
        with urllib.request.urlopen(url, timeout=240) as r:   # a query can take ~10-40s
            print(r.read().decode("utf-8", "replace"))
    except urllib.error.URLError as e:
        sys.exit("ask failed: %s" % e)

LOG_CHUNK = 4 << 20   # a transcript can run to hundreds of MB; over /pm it travels in pieces

def _read_chunk(path, start, tailing, cap=LOG_CHUNK):
    """Bytes of a transcript from `start`, and where the next read should begin.

    Cut at a line end, so each piece decodes cleanly and the next one starts on a whole record. A
    single line longer than the cap (a pasted image is one line) is cut at a character boundary
    instead. When `tailing`, a last line with no newline yet is held back: the agent is still
    writing it, and `-f` printing half a record then the rest reads as two. Negative `start` is
    that many bytes before the end, from the next whole line — how `tail` opens.
    """
    size = os.path.getsize(path)
    with open(path, "rb") as f:
        if start < 0:
            pos = max(0, size + start)
            f.seek(pos)
            if pos:
                f.readline()
        else:
            f.seek(start if start <= size else 0)   # shorter than last time: it was rewritten
        start = f.tell()
        data = f.read(cap)
    if data and not data.endswith(b"\n") and (tailing or start + len(data) < size):
        cut = data.rfind(b"\n") + 1
        if cut == 0 and len(data) == cap:
            cut = len(data)
            while cut > 0 and (data[cut - 1] & 0xC0) == 0x80:
                cut -= 1
            if cut > 0 and data[cut - 1] >= 0xC0:
                cut -= 1
        data = data[:cut]
    return data, start + len(data), size


def _log_remote(a):
    """`log` against another machine: the path and its state as that machine sees them, and with
    -c/-f the transcript itself, read there and carried back a piece at a time."""
    head = ["log", a.sel]
    if a.path_only:
        forward(head + ["-p"])
    if not (a.cat or a.follow):
        forward(head)
    code, out, err = pm_remote(head)
    sys.stdout.write(out)
    sys.stderr.write(err)
    if code or "[exists]" not in out:
        sys.exit(code)
    off = 0 if a.cat else -8192
    try:
        while True:
            code, out, err = pm_remote(head + ["--bytes-from=%d" % off] + ([] if a.cat else ["--tailing"]))
            m = re.search(r"^@offset (\d+) (\d+)", err, re.M)
            if code or not m:
                sys.stderr.write(err)
                sys.exit(code or "unexpected answer from %s" % BASE)
            sys.stdout.write(out)
            sys.stdout.flush()
            off, size = int(m.group(1)), int(m.group(2))
            if off >= size or not out:
                if a.cat:
                    return
                time.sleep(1.0)
    except KeyboardInterrupt:
        pass


def cmd_log(a):
    if is_remote():
        return _log_remote(a)
    st = state(); t = resolve(st, a.sel)
    tp = t.get("transcript")
    if a.bytes_from is not None:
        # One piece of the transcript for a caller on another machine (see _log_remote).
        if not tp or not os.path.exists(tp):
            sys.exit("no transcript for %s" % t["name"])
        data, nxt, size = _read_chunk(tp, a.bytes_from, a.tailing)
        sys.stderr.write("@offset %d %d\n" % (nxt, size))
        sys.stdout.flush()
        sys.stdout.buffer.write(data)
        return
    if not tp:
        slug = t.get("cwd", "").replace("/", "-").replace("_", "-")
        guess = os.path.join(HOME, ".claude", "projects", slug)
        print(c("33", "no transcript captured yet") + " for %s (agent=%s)." % (t["name"], t.get("agent") or "-"))
        print("send a prompt / interact once so a hook records the exact file, then retry.")
        print("likely Claude dir: %s" % guess)
        return
    if a.path_only:
        print(tp); return
    exists = os.path.exists(tp)
    meta = ""
    if exists:
        stt = os.stat(tp)
        meta = "  %s  %s" % (short_bytes(stt.st_size), time.strftime("%Y-%m-%d %H:%M", time.localtime(stt.st_mtime)))
    print("%s  [%s]%s" % (tp, "exists" if exists else c("31", "missing"), meta))
    if a.cat and exists:
        with open(tp, errors="replace") as f:
            sys.stdout.write(f.read())
    elif a.follow and exists:
        os.execvp("tail", ["tail", "-f", tp])

def _rename(tid, name):
    # quote_via=quote for the same reason cmd_send does it: "+" would come back as a literal plus.
    api_json("/action?" + urllib.parse.urlencode({"id": tid, "do": "rename", "name": name},
                                                 quote_via=urllib.parse.quote))


def _wait_session(tid, timeout=20.0):
    """Block until the new terminal's tmux session exists.

    `/new` returns as soon as the card does, but keystrokes go to the tmux session, which comes up
    a moment later — typing in between is silently dropped. `canOpen` is the authoritative flag:
    the snapshot computes it from a live list-sessions on this instance.
    """
    deadline = time.time() + timeout
    while time.time() < deadline:
        if any(t["id"] == tid and t.get("canOpen") for t in state()["terminals"]):
            # The session exists; the shell inside it may still be drawing its first prompt, and a
            # command typed into that gap lands in the raw tty and is eaten by zsh's line editor.
            time.sleep(0.6)
            return True
        time.sleep(0.4)
    return False


def cmd_new(a):
    st = state()
    matches = match_projects(st, a.sel)
    if not matches:
        sys.exit("no project %r on the board — a folder in ~/PycharmProjects can be opened with: "
                 "project-manager open %s --terminal" % (a.sel, a.sel))
    if len(matches) != 1:
        sys.exit("specify one project (matched %d)" % len(matches))
    r = api_json("/new?projectId=" + matches[0]["id"])
    tid = r.get("id") or ""
    if not tid:
        sys.exit("FleetView returned no terminal id")
    done = ["opened %s in %s" % (c("1", tid[:8].lower()), matches[0]["name"])]
    # `new <project> <label>` and `-n <label>` are the same thing; the flag wins if both are given.
    label = a.name or a.label
    if label:
        _rename(tid, label)
        done.append("named %r" % label)
    cmd = CLAUDE_CMD if a.claude else a.cmd
    if cmd:
        if not _wait_session(tid):
            # The card is real and stays; only the typing failed, so say which half happened.
            print(", ".join(done))
            sys.exit("session did not come up within 20s — nothing typed")
        api_json("/type?" + urllib.parse.urlencode(
            {"id": tid, "text": cmd, "enter": "1"}, quote_via=urllib.parse.quote))
        done.append("running %s" % c("1", cmd))
    print(", ".join(done))


def cmd_open(a):
    """Put a folder from ~/PycharmProjects on the board, optionally with a terminal running in it.

    The same act as the web dashboard's 📂 — and, like it, fenced to folders directly inside
    ~/PycharmProjects; the server refuses anything else. Goes through the API, so -u works.
    """
    try:
        ws = json.loads(_get("/workspace"))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            sys.exit("this FleetView predates `open` (no /workspace) — update the app")
        raise
    except urllib.error.URLError as e:
        sys.exit("cannot reach FleetView at %s (%s)" % (BASE, e))
    folders = ws.get("folders") or []
    sl, sn = a.sel.lower().strip(), _norm(a.sel)
    hit = None
    for test in (lambda f: f["name"].lower() == sl or f["path"] == os.path.expanduser(a.sel).rstrip("/"),
                 lambda f: _norm(f["name"]) == sn,
                 lambda f: sl in f["name"].lower(),
                 lambda f: sn and sn in _norm(f["name"])):
        hits = [f for f in folders if test(f)]
        if len(hits) == 1:
            hit = hits[0]; break
        if len(hits) > 1:
            print("%r matches several folders:" % a.sel, file=sys.stderr)
            for f in hits[:12]:
                print("  " + f["name"], file=sys.stderr)
            sys.exit(2)
    if hit is None:
        import difflib
        close = difflib.get_close_matches(a.sel, [f["name"] for f in folders], n=4, cutoff=0.5)
        sys.exit("no folder %r in %s%s" % (a.sel, _tilde(ws.get("root") or "~/PycharmProjects"),
                                             " — closest: " + ", ".join(close) if close else ""))
    pid = hit.get("projectId")
    if pid:
        said = "%s is already on the board" % hit["name"]
    else:
        r = api_json("/project/open?" + urllib.parse.urlencode({"path": hit["path"]}, quote_via=urllib.parse.quote))
        pid = r.get("id") or ""
        said = "opened %s as a project" % c("1", hit["name"])
    cmd = CLAUDE_CMD if a.claude else (CODEX_CMD if a.codex else None)
    if not (a.terminal or cmd):
        print(said); return
    r = api_json("/new?projectId=" + pid)
    tid = r.get("id") or ""
    if not tid:
        sys.exit(said + ", but FleetView returned no terminal id")
    if a.name:
        _rename(tid, a.name)
    said += ", terminal %s" % c("1", tid[:8].lower())
    if cmd:
        if not _wait_session(tid):
            print(said); sys.exit("session did not come up within 20s — nothing typed")
        api_json("/type?" + urllib.parse.urlencode({"id": tid, "text": cmd, "enter": "1"},
                                                   quote_via=urllib.parse.quote))
        said += " running %s" % cmd.split()[0]
    print(said)


def _wait_agent_ready(tid, timeout=120):
    """Wait until the agent in a freshly opened terminal can actually take a prompt.

    The tmux session exists well before the CLI does — `claude` spends seconds loading MCP servers
    and skills — and a prompt typed into that gap is swallowed by a half-built TUI without a trace,
    which for a subagent means it sits there forever having never been told what to do.

    Only `agent` is waited on, deliberately. Claude also flips `status` off `shell` when its
    SessionStart hook fires, but Codex does not — it skips hooks it has not been told to trust, so
    its cards sit on `shell` for the life of the session. Requiring both hung here for the full
    timeout while Codex was visibly up and idle at its prompt.
    
    Even for Claude this is only the cheap first gate: the hook fires early in startup, while the
    TUI is still drawing its banner and dropping keystrokes. `_send_task` is what actually confirms
    the task arrived.
    """
    deadline = time.time() + timeout
    while time.time() < deadline:
        for t in state()["terminals"]:
            if t["id"].lower().startswith(tid.lower()):
                if t.get("agent") or "":
                    return True
                break
        time.sleep(0.5)
    return False


def _send_task(tid, task, attempts=20):
    """Type the task, then confirm it actually arrived — and retype it if it did not.

    "Sent" and "arrived" are different things here. A TUI still building itself accepts keystrokes
    into a buffer it then clears, so the send succeeds, the card looks started, and the subagent
    sits forever having never been told what to do. There is no readiness signal that covers this:
    the hook fires too early and the banner keeps redrawing after it.

    So: send, look for the text on the pane, and try again if it is not there. Checking before each
    retry is what keeps a slow start from turning into the same task queued five times — verified,
    a delivered task appears exactly once in the transcript.

    ~20 attempts because this now carries the whole readiness question: a cold Codex with its
    banners, or a Claude loading many MCP servers, can take most of a minute.
    """
    # Head or tail, squeezed: a long task scrolls in Claude's composer (the head goes off the top)
    # and wraps at the pane's width either way. Looking for the head alone retyped a task that was
    # sitting right there.
    s = _squeeze(task)
    probes = {s[:16], s[-12:]}
    q = urllib.parse.urlencode({"id": tid, "text": task, "enter": "1"},
                               quote_via=urllib.parse.quote)

    def landed():
        pane = api_text("/capture?id=%s&lines=40" % tid)
        flat = _squeeze(pane)
        # Already landed — either sitting in the composer or already being worked on.
        return any(p in flat for p in probes) or "esc to interrupt" in pane

    for _ in range(attempts):
        if landed():
            return True
        api_json("/type?" + q)
        for _ in range(6):
            time.sleep(0.5)
            if landed():
                return True
    return False


def _submit_if_pending(tid, task, tries=8):
    """Press Enter again if the task is sitting typed-but-unsent.

    `/type` sends the text and the Return together, and Codex during its banner phase takes the
    text and drops the Return — the task then sits in the composer forever, which reads on the board
    as a subagent that was given work and ignored it. Measured: the text arrived, `› <task>` stayed
    on screen, nothing ran. A current FleetView already retries this itself; this is the same check
    from outside, which is harmless after a success and the whole fix against an older instance.
    """
    probe = _probe(task)
    if probe is None:
        return True
    for _ in range(tries):
        if not _composer_holds(api_text("/capture?id=%s&lines=40" % tid), probe):
            return True
        api_json("/key?" + urllib.parse.urlencode({"id": tid, "k": "Enter"}))
        time.sleep(1.0)
    return False


def cmd_subagent(a):
    """Open a new agent terminal and hand it a task.

    Defaults to the caller's own project, because a subagent belongs to the work that spawned it —
    an agent asking for one rarely means "somewhere else".
    """
    st = state()
    if a.project:
        ps = match_projects(st, a.project)
        if len(ps) != 1:
            sys.exit("specify one project (matched %d)" % len(ps))
        proj = ps[0]
    else:
        mine = my_card()
        if mine is None:
            sys.exit("not inside a FleetView terminal — name the project with -p")
        proj = mine[2]
        if proj is None:
            sys.exit("could not resolve your own project — name it with -p")
        if is_remote():
            # Your project lives on this Mac; over there it can only mean the one of the same name.
            same = [p for p in st["projects"] if p["name"].lower() == proj["name"].lower()]
            if len(same) != 1:
                sys.exit("%s has %s project called %r — name one with -p"
                         % (BASE, "no" if not same else "more than one", proj["name"]))
            proj = same[0]

    task = " ".join(a.text).strip()
    if not task:
        sys.exit("empty task")

    r = api_json("/new?projectId=" + proj["id"])
    tid = r.get("id") or ""
    if not tid:
        sys.exit("FleetView returned no terminal id")
    full = tid.lower()
    kind = "codex" if a.codex else "claude"
    # The caller is usually an agent that now has to address this terminal, so the full uuid is the
    # answer — it is what `show`/`send`/`check` and the HTTP API all take, and it is printed on every
    # path, success or not: the card exists either way, and one that cannot be named is one nobody
    # can finish by hand.
    #
    # With --id it is the only thing on stdout, so `$(project-manager subagent --id …)` captures it
    # cleanly; everything else moves to stderr.
    def say(msg):
        print(msg, file=sys.stderr if a.id_only else sys.stdout)

    def done(msg, code=0):
        if a.id_only:
            say(msg)
            print(full)
        else:
            say(msg)
        sys.exit(code)

    # The card is named after the task by default: a board of "FleetView-7" tells you nothing about
    # which subagent is which.
    _rename(tid, a.name or ("⚙ " + task[:24]))

    if not _wait_session(tid):
        done("opened %s in %s — session did not come up within 20s, nothing typed"
             % (full, proj["name"]), 1)
    cmd = CODEX_CMD if a.codex else CLAUDE_CMD
    api_json("/type?" + urllib.parse.urlencode({"id": tid, "text": cmd, "enter": "1"},
                                               quote_via=urllib.parse.quote))
    if a.no_wait:
        done("opened %s in %s, starting %s (task NOT sent: --no-wait)"
             % (c("1", full), proj["name"], kind))
    if not _wait_agent_ready(tid):
        # The terminal is real and the CLI may still come up; say what did and did not happen rather
        # than leaving a card that looks like it was given a task.
        done("opened %s in %s — agent did not report ready within 120s, task NOT sent; "
             "send it with: project-manager send %s '<task>'" % (full, proj["name"], full[:8]), 1)
    if not _send_task(tid, task):
        done("opened %s in %s — agent started but the task would not stick; "
             "send it with: project-manager send %s '<task>'" % (full, proj["name"], full[:8]), 1)
    if not _submit_if_pending(tid, task):
        done("subagent %s in %s (%s) — task typed but NOT submitted; press Enter with: "
             "project-manager key %s enter" % (c("1", full), proj["name"], kind, full[:8]), 1)
    done("subagent %s in %s (%s) — task delivered" % (c("1", full), proj["name"], kind))


def cmd_rename(a):
    t = resolve(state(), a.sel)
    name = " ".join(a.text).strip()
    if not name:
        sys.exit("empty name")
    _rename(t["id"], name)
    print("%s  %s -> %s" % (t["id"][:8].lower(), t["name"], c("1", name)))

def cmd_rm(a):
    t = resolve(state(), a.sel)
    api_json("/action?" + urllib.parse.urlencode({"id": t["id"], "do": "remove"}))
    print("removed %s" % t["name"])

RESTORED = {"already_open": "already open:", "reopened": "reopened", "restored": "restored",
            "created": "opened a new card:"}

def cmd_restore(a):
    """Bring a conversation back by its session id: its card on the board, its agent resumed in it.

    FleetView decides where it lands — the card already showing it, a closed card, a removed card
    from the drawer (same name, id and project), or a new card in the folder it ran in — so this
    works the same against another Mac with -u.
    """
    try:
        r = json.loads(_get("/restore?" + urllib.parse.urlencode({"sid": a.sid}), timeout=30))
    except urllib.error.HTTPError as e:
        try:
            err = json.loads(e.read().decode("utf-8", "replace"))
        except ValueError:
            sys.exit("%s does not know `restore` (HTTP %d): its FleetView predates the command" % (BASE, e.code))
        sys.exit(err.get("error", "HTTP %d" % e.code)
                 + "".join("\n  " + m for m in err.get("matches", [])))
    except urllib.error.URLError as e:
        sys.exit("cannot reach FleetView at %s (%s)." % (BASE, e))
    print("%s %s  %s  %s · %s session %s" % (
        RESTORED.get(r["action"], r["action"]), c("1", r["name"]), r["id"][:8].lower(),
        r["project"], r["agent"], r["session"][:8]))
    if r.get("resolvedFrom"):
        print("  %s is a Codex worker; restored the conversation it belongs to" % r["resolvedFrom"][:8])
    if a.no_wait or r["action"] == "already_open":
        return
    # Up means its hook reported in. A card stays on `shell` until then — and for good if Codex has
    # not been told to trust FleetView's hooks, which is worth saying rather than waiting forever.
    deadline = time.time() + 90
    while time.time() < deadline:
        t = next((t for t in state()["terminals"] if t["id"].lower() == r["id"].lower()), None)
        if t and t.get("status") in ("idle", "working", "needsYou"):
            print("  %s is back (%s)" % (r["agent"], t.get("statusLabel") or t["status"]))
            return
        time.sleep(1)
    print("  the terminal is open and the resume was typed, but no agent has reported in yet — "
          "look with: %s" % _cmd("project-manager show %s" % r["id"][:8].lower()))

def cmd_notes(a):
    """The sidebar Notes list, which is also the web dashboard's quick-command chips.

    It rides on /state and /note like everything else here, so -u reaches another machine's notes
    exactly the same way it reaches its terminals.
    """
    notes = state().get("notes", [])
    act = a.action or "ls"

    if act == "add":
        text = " ".join(a.rest).strip()
        if not text:
            sys.exit("nothing to add")
        # quote_via=quote so a literal "+" survives: the server reads "+" as a space (form encoding).
        api_json("/note?" + urllib.parse.urlencode({"add": text}, quote_via=urllib.parse.quote))
        print("added: %s" % text.splitlines()[0][:70])
        return

    if act == "rm":
        if not a.rest:
            sys.exit("which note? (number, id prefix, or text substring)")
        n = resolve_note(notes, " ".join(a.rest))
        api_json("/note?" + urllib.parse.urlencode({"del": n["id"]}))
        # Echo the full text back: deletion is not undoable in the app, so this is the re-add path.
        print("removed note %s:" % n["id"][:8].lower())
        for line in n["text"].splitlines() or [""]:
            print("  " + line)
        return

    if not notes:
        print("no notes"); return
    q = " ".join(a.rest).strip().lower() or (a.filter or "").strip().lower()
    shown = [(i, n) for i, n in enumerate(notes, 1) if not q or q in n["text"].lower()]
    if not shown:
        print("no note matches %r (%d notes)" % (q, len(notes))); return
    for i, n in shown:
        if a.plain:
            print(n["text"]); continue
        head = "%3d  %s  " % (i, c("90", n["id"][:8].lower()))
        lines = n["text"].splitlines() or [""]
        print(head + lines[0])
        for extra in lines[1:]:
            print(" " * 15 + extra)   # keep a multi-line note visibly one item
    if q and not a.plain:
        print(c("90", "%d of %d notes" % (len(shown), len(notes))))

# ======================================================================================
# History — which projects, which conversations, what was said, and where the files are.
#
# Four levels, each capped and each ending with the command for the level below, so a caller
# spends context one level at a time instead of pouring a transcript into it:
#
#   projects             L0  projects by last activity, two lines each
#   history <project>    L1  its conversations: title, span, turns, transcript path
#   session <id>         L2  one conversation, one line per turn
#   session <id> -t N    L3  one turn, in full
#   search <words>       across all of it, grouped by conversation, with turn numbers into L3
#
# Read-only, and bound to the machine whose files it reads: this Mac's transcripts and FleetView's
# search index (~/.fleetview/search.db). With -u the whole command runs on that machine instead
# (main → forward → GET /pm), so everything below only ever reads the disk it is running on. The
# why behind every rule below is in docs/design/2026-09-26-send-and-project-history.md.
# ======================================================================================

CLAUDE_ROOT = os.path.join(HOME, ".claude", "projects")
CODEX_ROOT = os.path.join(HOME, ".codex", "sessions")
FV_DIR = os.path.join(HOME, ".fleetview")
INDEX_DB = os.path.join(FV_DIR, "search.db")
HEADS_CACHE = os.path.join(FV_DIR, "cache", "history-heads.json")
SCRATCH = "(scratch)"
SCRATCH_PREFIXES = ("/private/tmp/", "/tmp/", "/private/var/folders/", "/var/folders/")

# Text that reaches a transcript as a user message but was never typed. Measured on this corpus:
# <task-notification> alone is 6,183 "prompts" — left in, it would be most of every outline.
INJECTED = ("<task-notification>", "<subagent_notification>", "<recommended_plugins>",
            "This session is being continued from a previous conversation", "<heartbeat>",
            "Base directory for this skill", "[SYSTEM NOTIFICATION", "<user_instructions>",
            "# AGENTS.md instructions", "<environment_context>", "<turn_aborted>")
_INJECTED_SQL = " AND ".join("body NOT LIKE ?" for _ in INJECTED)
_INJECTED_ARGS = [s + "%" for s in INJECTED]

# Real prompts that make poor titles: they say "carry on", not what the conversation is about.
WEAK_TITLES = ("Continue from where you left off", "[Image", "继续")

# What the indexer drops before storing a prompt (SearchIndex.noise). The tail parser below has to
# drop the same things, or a turn would be numbered differently before and after a refresh.
INDEX_NOISE = ("<local-command", "<command-name", "<command-message", "<command-args",
               "<system-reminder", "<user-memory", "Caveat: The messages below",
               "[Request interrupted", "<bash-input", "<bash-stdout", "<bash-stderr")


def _tilde(p):
    return "~" + p[len(HOME):] if p == HOME or p.startswith(HOME + "/") else p

def _clip(s, n):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[:n - 1] + "…"

def _epoch(iso):
    if not iso:
        return None
    import datetime
    try:
        return datetime.datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None

def _when(t, day=True):
    if t is None:
        return "?"
    return time.strftime("%m-%d %H:%M" if day else "%H:%M", time.localtime(t))

def _span(a, b):
    if a is None or b is None:
        return _when(a or b)
    same = time.localtime(a)[:3] == time.localtime(b)[:3]
    return "%s → %s" % (_when(a), _when(b, day=not same))

def _injected(body):
    return body.startswith(INJECTED)


# ---- reading a transcript's tail the way the indexer would ----

def _clean_prompt(raw):
    t = (raw or "").strip()
    if not t or t.startswith(INDEX_NOISE):
        return None
    r = t.find("<system-reminder>")
    if r > 0:
        t = t[:r].strip()
    return t or None

def _codex_text(payload):
    parts = []
    for b in payload.get("content") or []:
        if isinstance(b, dict):
            t = b.get("text") or b.get("input_text") or b.get("output_text") or ""
            if t:
                parts.append(t)
    return "\n".join(parts).strip()

def _parse_rows(path, src, start=0, cap=96 << 20):
    """(role, iso-ts, text) from byte `start` on, by SearchIndex's rules; role 0 = you, 1 = agent.

    Used only for what the index has not reached yet — a tail written since its last refresh, or a
    conversation newer than it. Stops before a partial last line, as the indexer does.
    """
    rows = []
    try:
        with open(path, "rb") as f:
            f.seek(start)
            data = f.read(cap)
    except OSError:
        return rows
    end = data.rfind(b"\n")
    for line in data[:end + 1].split(b"\n") if end >= 0 else []:
        if src == 0:
            if b'"type":"user"' not in line and b'"type":"assistant"' not in line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            typ, msg = o.get("type"), o.get("message")
            if typ not in ("user", "assistant") or not isinstance(msg, dict):
                continue
            role, ts, content = (0 if typ == "user" else 1), o.get("timestamp") or "", msg.get("content")
            texts = [content] if isinstance(content, str) else \
                [b.get("text", "") for b in content or [] if isinstance(b, dict) and b.get("type") == "text"]
            for raw in texts:
                t = _clean_prompt(raw) if role == 0 else ((raw or "").strip() or None)
                if t:
                    rows.append((role, ts, t))
        else:
            if b'"role":"' not in line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            p = o.get("payload") or {}
            if o.get("type") != "response_item" or p.get("type") != "message":
                continue
            txt, ts = _codex_text(p), o.get("timestamp") or ""
            if p.get("role") == "user":
                if txt and not txt.startswith(("<environment_context>", "<turn_aborted>")):
                    t = _clean_prompt(txt)
                    if t:
                        rows.append((0, ts, t))
            elif p.get("role") == "assistant" and txt:
                rows.append((1, ts, txt))
    return rows


# ---- what kind of transcript a file is (cached: a head never changes) ----

def _classify(path, src):
    """{"kind": main | sub | exec, "parent": sid, "cwd": …} from where the file is and how it opens.

    sub  — a subagent thread: Claude `<sid>/subagents/agent-*.jsonl`, Codex `source.subagent`.
           Folded into its parent; 5,812 of them on this Mac, so listing them would bury everything.
    exec — not a conversation anyone had: `claude -p` (entrypoint sdk-cli), `codex exec`.
    """
    if src == 0:
        parts = path.split(os.sep)
        if "subagents" in parts:
            return {"kind": "sub", "parent": parts[parts.index("subagents") - 1]}
        try:
            with open(path, "rb") as f:
                head = f.read(256 << 10)
        except OSError:
            return {"kind": "main"}
        ep = cwd = None
        for line in head.split(b"\n")[:300]:
            if b'"entrypoint"' not in line and b'"cwd"' not in line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            ep, cwd = ep or o.get("entrypoint"), cwd or o.get("cwd")
            if ep and cwd:
                break
        d = {"kind": "exec" if ep == "sdk-cli" else "main", "cwd": cwd}
        if ep is None and len(head) < (256 << 10):
            d["tentative"] = len(head)       # too young to say; look again once it has grown
        return d
    try:
        with open(path, "rb") as f:
            p = json.loads(f.readline(8 << 20)).get("payload") or {}
    except (OSError, ValueError):
        return {"kind": "main"}
    s = p.get("source")
    if isinstance(s, dict) and "subagent" in s:
        spawn = s["subagent"].get("thread_spawn") if isinstance(s["subagent"], dict) else None
        return {"kind": "sub", "parent": (spawn or {}).get("parent_thread_id"), "cwd": p.get("cwd")}
    return {"kind": "exec" if s == "exec" else "main", "cwd": p.get("cwd")}

def _sid_from_path(path, src):
    stem = os.path.basename(path)[:-len(".jsonl")]
    if src == 1:
        return "-".join(stem.split("-")[-5:])      # rollout-<time>-<uuid>
    return stem


def _git_root(d, cache={}):
    if d in cache:
        return cache[d]
    cur, found = d, None
    while cur.startswith(HOME + "/"):
        if os.path.exists(os.path.join(cur, ".git")):
            found = cur
            break
        cur = os.path.dirname(cur)
    cache[d] = found
    return found


class _History:
    """Every transcript on this Mac, as the index and the disk see it, grouped into projects."""

    def __init__(self):
        import sqlite3
        host = urllib.parse.urlparse(BASE).hostname or ""
        if host not in ("127.0.0.1", "localhost", "::1"):
            # main() sends these to the -u machine before they get here. Reaching this means that
            # was skipped, and answering from this Mac's files would describe the wrong machine's
            # history under that machine's name.
            sys.exit("history reads this Mac's transcripts, not %s's" % host)
        if not os.path.exists(INDEX_DB):
            sys.exit("no conversation index at %s — FleetView builds it at launch" % _tilde(INDEX_DB))
        self.db = sqlite3.connect("file:%s?mode=ro" % INDEX_DB, uri=True)
        self.now = time.time()
        self._load_fleet()
        files = {}
        for path, src, sid, cwd, done in self.db.execute(
                "SELECT path, src, session, project, done FROM file"):
            files[path] = {"path": path, "src": src, "sid": sid, "cwd": cwd, "done": done,
                           "size": None, "mtime": None}
        for root, src in ((CLAUDE_ROOT, 0), (CODEX_ROOT, 1)):
            for dp, _, names in os.walk(root):
                for n in names:
                    if not n.endswith(".jsonl"):
                        continue
                    p = os.path.join(dp, n)
                    try:
                        st = os.stat(p)
                    except OSError:
                        continue
                    e = files.get(p)
                    if e is None:
                        e = files[p] = {"path": p, "src": src, "sid": _sid_from_path(p, src),
                                        "cwd": "", "done": 0}
                    e["size"], e["mtime"] = st.st_size, st.st_mtime
        self._classify_all(files)
        self.files = files

        # Sessions are main transcripts; subagent threads count toward their parent.
        self.sessions = {}
        for e in files.values():
            if e["kind"] in ("main", "exec"):
                e["subs"] = 0
                self.sessions[e["path"]] = e
        by_sid = {}
        for e in self.sessions.values():
            by_sid.setdefault(e["sid"].lower(), e)
        for e in files.values():
            if e["kind"] == "sub":
                parent = by_sid.get((e.get("parent") or "").lower())
                if parent:
                    parent["subs"] += 1
                    e["parent_path"] = parent["path"]

        self.roots = {}
        for e in self.sessions.values():
            e["root"] = self._root(e["cwd"])
            e["card"] = self.cards.get(e["path"])

    # -- sources --

    def _load_fleet(self):
        """FleetView's own knowledge: project names, and a name for every conversation that ever
        had a card — the archive keeps removed cards' transcript paths, and a card name is the best
        title a conversation has."""
        self.named, self.cards, anchors = {}, {}, set()
        try:
            with open(os.path.join(FV_DIR, "state.json")) as f:
                st = json.load(f)
        except (OSError, ValueError):
            st = {}
        for p in st.get("projects") or []:
            if p.get("path"):
                self.named[p["path"].rstrip("/")] = p.get("name") or os.path.basename(p["path"])
        for t in st.get("terminalArchive") or []:
            if t.get("projectPath"):
                anchors.add(t["projectPath"].rstrip("/"))
            if t.get("transcriptPath"):
                self.cards[t["transcriptPath"]] = {"name": t.get("name") or "", "id": t.get("id") or "",
                                                   "live": False}
        for t in st.get("terminals") or []:
            if t.get("transcriptPath"):
                self.cards[t["transcriptPath"]] = {"name": t.get("name") or "", "id": t.get("id") or "",
                                                   "live": True}
        # FleetView projects — including ones since removed from the board — anchor attribution:
        # the user drew those boundaries. Longest first, so a nested project wins over its parent.
        self.anchors = sorted(set(self.named) | anchors, key=len, reverse=True)
        self.project_names = set(self.named.values()) | {os.path.basename(a) for a in anchors}

    def _classify_all(self, files):
        try:
            with open(HEADS_CACHE) as f:
                heads = json.load(f)
        except (OSError, ValueError):
            heads = {}
        dirty = False
        for p, e in files.items():
            h = heads.get(p)
            stale = h is not None and h.get("tentative") is not None and (e["size"] or 0) > h["tentative"]
            if h is None or stale:
                if e["size"] is None and "/subagents/" not in p:
                    h = {"kind": "main"}               # gone from disk; the index is all there is
                else:
                    h = _classify(p, e["src"])
                heads[p] = h
                dirty = True
            e["kind"], e["parent"] = h.get("kind", "main"), h.get("parent")
            if not e["cwd"] and h.get("cwd"):
                e["cwd"] = h["cwd"]
        if dirty:
            try:
                os.makedirs(os.path.dirname(HEADS_CACHE), exist_ok=True)
                tmp = HEADS_CACHE + ".%d.tmp" % os.getpid()
                with open(tmp, "w") as f:
                    json.dump(heads, f)
                os.replace(tmp, HEADS_CACHE)
            except OSError:
                pass                                   # a cache that cannot be written only costs time

    def _root(self, cwd):
        """Which project a working directory belongs to (see the design note for the order)."""
        if not cwd:
            return "(unknown)"
        cwd = cwd.rstrip("/") or "/"
        if cwd.startswith(SCRATCH_PREFIXES) or cwd in ("/tmp", "/private/tmp"):
            return SCRATCH
        for a in self.anchors:
            if cwd == a or cwd.startswith(a + "/"):
                return a
        g = _git_root(cwd)
        if g and g != HOME:
            return g
        # Fold a subdirectory into an ancestor that has conversations of its own — but never above
        # $HOME/<x>/<y>, or one session run in ~/PycharmProjects would swallow every repo in it.
        floor = len(HOME.split("/")) + 2
        seen = self._cwds()
        cur = os.path.dirname(cwd)
        best = cwd
        while len(cur.split("/")) >= floor:
            if cur in seen:
                best = cur
            cur = os.path.dirname(cur)
        return best

    def _cwds(self):
        if not hasattr(self, "_cwd_set"):
            self._cwd_set = {(e["cwd"] or "").rstrip("/") for e in self.files.values()
                             if e["kind"] in ("main", "exec")}
        return self._cwd_set

    def name(self, root):
        if root in self.named:
            return self.named[root]
        if root in (SCRATCH, "(unknown)"):
            return root
        return "~" if root == HOME else os.path.basename(root)

    # -- what the index knows, per transcript --

    def prompt_stats(self, paths=None):
        """{path: [turns, first_ts, last_ts, first_id, last_id]} over real prompts."""
        sql = ("SELECT path, COUNT(*), MIN(ts), MAX(ts), MIN(id), MAX(id) FROM msg "
               "WHERE role = 0 AND " + _INJECTED_SQL)
        args = list(_INJECTED_ARGS)
        if paths is not None:
            paths = list(paths)
            if not paths:
                return {}
            sql += " AND path IN (%s)" % ",".join("?" * len(paths))
            args += paths
        out = {}
        for path, n, a, b, i, j in self.db.execute(sql + " GROUP BY path", args):
            out[path] = [n, _epoch(a), _epoch(b), i, j]
        return out

    def rows(self, e):
        """Every message of one transcript: the index's rows, then whatever it has not reached."""
        rows = [(r, ts, body) for r, ts, body in self.db.execute(
            "SELECT role, ts, body FROM msg WHERE path = ? ORDER BY id", (e["path"],))]
        if e["size"] is not None and e["size"] > (e["done"] or 0):
            rows += _parse_rows(e["path"], e["src"], e["done"] or 0)
        return rows

    def fresh_tail(self, e):
        """Real prompts past the index — (count, first_ts, last_ts, first, last) — or None."""
        if e["size"] is None or e["size"] <= (e["done"] or 0):
            return None
        ps = [(ts, t) for r, ts, t in _parse_rows(e["path"], e["src"], e["done"] or 0)
              if r == 0 and not _injected(t)]
        if not ps:
            return None
        return len(ps), _epoch(ps[0][0]), _epoch(ps[-1][0]), ps[0][1], ps[-1][1]

    def body(self, msg_id):
        r = self.db.execute("SELECT body FROM msg WHERE id = ?", (msg_id,)).fetchone()
        return r[0] if r else ""

    def title_prompt(self, e):
        """The first prompt that says something — "继续" and "hi" open plenty of conversations."""
        for (body,) in self.db.execute(
                "SELECT body FROM msg WHERE path = ? AND role = 0 ORDER BY id LIMIT 40", (e["path"],)):
            if not _injected(body) and len(_squeeze(body)) >= 8 and not body.startswith(WEAK_TITLES):
                return body
        return None

    def last_active(self, e, stats=None):
        """When the conversation last moved.

        The file's mtime only when the file has grown past the index — growth is real activity.
        Otherwise the last message's own timestamp: transcripts get touched without being written to
        (seen here: week-old conversations all stamped with the same hour), and trusting mtime then
        floats dead conversations to the top.
        """
        if e["size"] is not None and e["size"] > (e["done"] or 0) and e["mtime"]:
            return e["mtime"]
        if not hasattr(self, "_last"):
            self._last = {p: _epoch(t) for p, t in
                          self.db.execute("SELECT path, MAX(ts) FROM msg GROUP BY path")}
        t = self._last.get(e["path"])
        return t if t is not None else e["mtime"]

    def lag(self):
        """Bytes of transcript the index has not read yet."""
        return sum(max(0, (e["size"] or 0) - (e["done"] or 0)) for e in self.files.values()
                   if e["size"] is not None)


def _session_summary(h, e, stats):
    """Turns, span, title and last prompt of one conversation, the index's view topped up with the
    tail it has not reached."""
    s = stats.get(e["path"]) or [0, None, None, None, None]
    turns, first_t, last_t = s[0], s[1], s[2]
    first = h.title_prompt(e) or (h.body(s[3]) if s[3] else "")
    last = h.body(s[4]) if s[4] else ""
    tail = h.fresh_tail(e)
    if tail:
        turns += tail[0]
        first_t = first_t or tail[1]
        last_t = tail[2] or last_t
        first = first or tail[3]
        last = tail[4]
    return {"turns": turns, "first_t": first_t, "last_t": last_t, "first": first, "last": last}

def _n(k, word):
    return "%d %s%s" % (k, word, "" if k == 1 else "s")

def _agent(e):
    return "codex" if e["src"] == 1 else "claude"

def _short_sid(e):
    # Codex ids are UUIDv7: the first 8 hex are a timestamp shared by every session started in the
    # same minute (a batch of 15 subagents all read 01a0da0b). The first 13 carry the millisecond.
    return e["sid"][:13] if e["src"] == 1 else e["sid"][:8]

def _card_title(h, card):
    """A card's name, when it says something.

    Two kinds do not: the default `<project>-<n>`, and names FleetView derived from a prompt that was
    itself injected (`⌕ <task-notifi ⑂`). A name someone chose — "DES-T8-015 difficulty repair",
    "rb-006" — is the best title a conversation has.
    """
    if not card:
        return None
    n = card["name"].strip("⌕⑂⚙ \t")
    m = re.fullmatch(r"(.+)-\d+", n)
    if m and m.group(1) in h.project_names:
        return None
    if len(n) < 3 or n.startswith(("<", "This session")):
        return None
    return n

def _card_note(h, card):
    if not card:
        return ""
    title = _card_title(h, card)
    named = '"%s"' % _clip(title, 40) if title else ""
    if card["live"]:
        return ("on the board as %s %s" % (card["id"][:8].lower(), named)).rstrip()
    return named


def _width(s):
    import unicodedata
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in s)

def _pad(s, w):
    """Left-justify by display width: a Chinese project name is twice as wide as its len()."""
    return s + " " * max(0, w - _width(s))


def _norm(s):
    return re.sub(r"[^0-9a-z一-鿿]+", "", s.lower())

def _resolve_project(h, sel, visible):
    """A project by name: exact, then ignoring _ - and spaces, then substring, then fuzzy."""
    cands = {root: h.name(root) for root in visible}
    sl, sn = sel.lower().strip(), _norm(sel)
    path = os.path.expanduser(sel).rstrip("/")
    for test in (lambda r, n: n.lower() == sl or r == path,
                 lambda r, n: _norm(n) == sn,
                 lambda r, n: sl in n.lower() or sl in r.lower(),
                 lambda r, n: sn and sn in _norm(n)):
        hits = [r for r, n in cands.items() if test(r, n)]
        if len(hits) == 1:
            return hits[0], None
        if len(hits) > 1:
            print("%r matches several projects:" % sel, file=sys.stderr)
            for r in hits[:12]:
                print("  %-24s %s" % (cands[r], _tilde(r)), file=sys.stderr)
            sys.exit(2)
    import difflib
    scored = sorted(((difflib.SequenceMatcher(None, sn, _norm(n)).ratio(), r)
                     for r, n in cands.items()), reverse=True)
    if scored and scored[0][0] >= 0.75 and (len(scored) == 1 or scored[0][0] - scored[1][0] >= 0.08):
        return scored[0][1], "no project is called %r; using %s" % (sel, cands[scored[0][1]])
    close = [cands[r] for s, r in scored[:5] if s >= 0.5]
    sys.exit(_cmd("no project matches %r%s  (project-manager projects lists them)")
             % (sel, " — closest: " + ", ".join(close) if close else ""))

def _visible(e, show_all):
    return show_all or (e["kind"] == "main" and e["root"] != SCRATCH)


def cmd_projects(a):
    h = _History()
    stats = h.prompt_stats()
    groups = {}
    for e in h.sessions.values():
        if not _visible(e, a.all):
            continue
        t = h.last_active(e, stats)
        if t is None:
            continue
        g = groups.setdefault(e["root"], {"last": 0, "latest": None, "n": 0, "turns": 0,
                                          "claude": 0, "codex": 0, "subs": 0})
        g["n"] += 1
        g["turns"] += (stats.get(e["path"]) or [0])[0]
        g[_agent(e)] += 1
        g["subs"] += e["subs"]
        if t > g["last"]:
            g["last"], g["latest"] = t, e
    rows = sorted(groups.items(), key=lambda kv: -kv[1]["last"])
    if a.days:
        rows = [r for r in rows if h.now - r[1]["last"] <= a.days * 86400]
    shown = rows[:a.n]
    if not shown:
        print("no conversations found%s" % (" in the last %d days" % a.days if a.days else "")); return
    w = min(24, max(_width(h.name(r)) for r, _ in shown))
    print(c("1", "PROJECTS") + c("90", "  by last activity · %d of %d%s"
                                 % (len(shown), len(rows), "" if a.all else " (-a adds scratch dirs and "
                                    "non-interactive runs)")))
    for root, g in shown:
        mix = " · ".join("%s %d" % (k, g[k]) for k in ("claude", "codex") if g[k])
        print("  %s %5s  %4d conv  %6s turns  %-18s %s" % (
            _pad(_clip(h.name(root), w), w), ago(int(h.now - g["last"])), g["n"],
            "{:,}".format(g["turns"]), mix, c("90", _tilde(root))))
        e = g["latest"]
        s = _session_summary(h, e, h.prompt_stats([e["path"]]))
        title = _card_title(h, e.get("card"))
        head = ('"%s"' % _clip(title, 36)) if title else _clip(s["first"], 60)
        # A one-prompt conversation's title IS its last prompt; say it once.
        same = not title and _squeeze(s["last"] or "")[:24] == _squeeze(s["first"] or "")[:24]
        print(c("90", "  %s  latest: %s%s" % (" " * w, head, "" if same else " — " + _clip(s["last"], 60))))
    lag = h.lag()
    if lag > 50 << 20:
        print(c("33", "index is %s behind the transcripts — counts may lag; FleetView catches up within minutes"
                % short_bytes(lag)))
    print(c("90", _cmd("next: project-manager history <project>   e.g. project-manager history %s")
            % h.name(shown[0][0])))


def _own_root(h):
    """The caller's project: its FleetView card's project if it is on one, else where it stands."""
    tid = _self_term_id()
    if tid:
        try:
            st = state()
            key = tid.replace("-", "").lower()
            me = next((t for t in st["terminals"] if t["id"].replace("-", "").lower() == key), None)
            p = me and next((q for q in st["projects"] if q["id"] == me.get("projectId")), None)
            if p:
                return h._root(p["path"])
        except SystemExit:
            pass
    return h._root(os.getcwd())


def cmd_history(a):
    h = _History()
    visible = {e["root"] for e in h.sessions.values() if _visible(e, a.all)}
    if a.project:
        root, note = _resolve_project(h, a.project, visible | {e["root"] for e in h.sessions.values()})
    else:
        root, note = _own_root(h), None
    if note:
        print(c("33", note))
    mine = [e for e in h.sessions.values() if e["root"] == root and _visible(e, a.all)]
    hidden = [e for e in h.sessions.values() if e["root"] == root and not _visible(e, a.all)]
    stats = h.prompt_stats([e["path"] for e in mine])
    mine.sort(key=lambda e: -(h.last_active(e, stats) or 0))
    if not mine:
        sys.exit("no conversations in %s (%s)" % (h.name(root), _tilde(root)))
    mix = ", ".join("%s %d" % (k, sum(1 for e in mine if _agent(e) == k)) for k in ("claude", "codex")
                    if any(_agent(e) == k for e in mine))
    subs = sum(e["subs"] for e in mine)
    print("%s — %s · %d conversations (%s)%s" % (
        c("1", h.name(root)), _tilde(root), len(mine), mix,
        c("90", " · %d subagent threads folded in" % subs) if subs else ""))
    mem = sum(len(_memory_notes(d)) for d in _memory_dirs(h, root))
    if mem:
        print(c("33", _cmd("  %s left by earlier agents — project-manager memory %s")
                % (_n(mem, "memory note"), h.name(root) if " " not in h.name(root) else '"%s"' % h.name(root))))
    briefs = {}
    for e in mine[:a.n]:
        s = _session_summary(h, e, stats)
        size = short_bytes(e["size"]) if e["size"] is not None else c("31", "file gone")
        print(("\n %s  %-6s %s  %s  %s  %s  %s" % (
            c("1", _short_sid(e)), _agent(e), _span(s["first_t"], s["last_t"]),
            c("90", "(%s ago)" % ago(int(h.now - h.last_active(e, stats)))) if h.last_active(e, stats) else "",
            _n(s["turns"], "turn"), size, _card_note(h, e["card"]))).rstrip())
        key = _squeeze(s["first"] or "")[:60]
        if key and key in briefs:
            print("    first: %s" % c("90", "(same opening brief as %s)" % briefs[key]))
        else:
            if key:
                briefs[key] = _short_sid(e)
            print("    first: %s" % _clip(s["first"], 100))
        if s["last"] and s["turns"] > 1:
            print("    last:  %s" % _clip(s["last"], 100))
        cwd = _tilde(e["cwd"]) if e["cwd"] and e["cwd"].rstrip("/") != root else ""
        print(c("90", "    %s%s" % (_tilde(e["path"]), "   (cwd %s)" % cwd if cwd else "")))
    more = len(mine) - a.n
    tail = []
    if more > 0:
        tail.append("%d older — -n %d" % (more, len(mine)))
    if hidden:
        tail.append("%d non-interactive/scratch hidden — -a" % len(hidden))
    if tail:
        print(c("90", "\n… " + " · ".join(tail)))
    print(c("90", _cmd("next: project-manager session <id>   (one line per turn)")))


def _resolve_session(h, sel):
    s = sel.strip()
    p = os.path.abspath(os.path.expanduser(s))
    if s.endswith(".jsonl"):
        e = h.files.get(p)
        if not e:
            sys.exit("not a transcript FleetView knows: %s" % s)
        return e
    key = s.lower().replace("-", "")
    if len(key) < 4:
        sys.exit("give at least 4 characters of the session id")
    hits = [e for e in h.sessions.values() if e["sid"].lower().replace("-", "").startswith(key)]
    if not hits:
        # A FleetView card id — live or removed — names the conversation it last held.
        paths = [tp for tp, card in h.cards.items()
                 if card["id"].lower().replace("-", "").startswith(key)]
        hits = [h.files[tp] for tp in paths if tp in h.files]
    if not hits:
        hits = [e for e in h.files.values() if os.path.basename(e["path"]).lower().startswith(s.lower())]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        sys.exit(_cmd("no conversation matches %r (ids come from project-manager history)") % sel)
    print("%r matches %d conversations:" % (sel, len(hits)), file=sys.stderr)
    for e in hits[:10]:
        print("  %s  %s  %s" % (e["sid"], _agent(e), _tilde(e["path"])), file=sys.stderr)
    sys.exit(2)


def _turns(rows):
    """Group messages into turns: a real prompt opens one, replies join the open one. Injected
    "prompts" join nothing — they are not something you said and not the agent answering."""
    turns = []
    for role, ts, body in rows:
        if role == 0:
            if not _injected(body):
                turns.append({"n": len(turns) + 1, "ts": _epoch(ts), "prompt": body, "replies": []})
        elif turns:
            turns[-1]["replies"].append(body)
    return turns


def _session_head(h, e, turns):
    root = e.get("root") or h._root(e["cwd"])
    kind = {"sub": "subagent thread", "exec": "non-interactive run"}.get(e["kind"], "")
    print("%s %s · %s · %s%s" % (c("1", "session"), e["sid"], _agent(e), h.name(root),
                                c("90", " · " + kind) if kind else ""))
    card = h.cards.get(e["path"])
    if card:
        print("  card:   %s" % (_card_note(h, card) or "removed from the board"))
    if e["cwd"]:
        print("  cwd:    %s" % _tilde(e["cwd"]))
    if e["size"] is not None:
        print("  file:   %s  (%s)" % (_tilde(e["path"]), short_bytes(e["size"])))
    else:
        print("  file:   %s  %s" % (_tilde(e["path"]), c("31", "[deleted — text below is from "
                                                              "FleetView's index; it cannot be resumed]")))
    a = turns[0]["ts"] if turns else None
    b = turns[-1]["ts"] if turns else None
    extra = " · " + _n(e["subs"], "subagent thread") if e.get("subs") else ""
    last = h.last_active(e) or b
    print("  span:   %s%s · %s%s" % (_span(a, b), " (%s ago)" % ago(int(h.now - last)) if last else "",
                                     _n(len(turns), "turn"), extra))
    if e["size"] is not None and e["kind"] != "sub" and e["cwd"]:
        cmd = "codex resume %s" % e["sid"] if e["src"] == 1 else "claude --resume %s" % e["sid"]
        print("  resume: cd %s && %s" % (_tilde(e["cwd"]), cmd))


def cmd_session(a):
    h = _History()
    e = _resolve_session(h, a.sel)
    if a.files:
        return _show_files(h, e)
    turns = _turns(h.rows(e))
    if a.turn:
        return _show_turns(h, e, turns, a)
    _session_head(h, e, turns)
    if not turns:
        print(c("90", "  (no prompts recorded)")); return
    # Runs of the same short prompt ("继续" ×5) are one line: the rhythm is the information.
    lines = []
    for t in turns:
        if lines and lines[-1]["prompt"] == t["prompt"] and len(t["prompt"]) <= 40:
            lines[-1]["times"] += 1
            continue
        lines.append({"n": t["n"], "ts": t["ts"], "prompt": t["prompt"], "times": 1})
    head, tail = (len(lines), 0) if a.all or len(lines) <= a.first + a.last else (a.first, a.last)
    print("turns%s:" % ("" if not tail else " — first %d and last %d of %d lines (--all for every one)"
                        % (head, tail, len(lines))))
    prev_day = None

    def show(ln):
        nonlocal prev_day
        day = time.localtime(ln["ts"])[:3] if ln["ts"] else None
        stamp = _when(ln["ts"], day=day != prev_day)
        prev_day = day
        rep = c("90", " (×%d)" % ln["times"]) if ln["times"] > 1 else ""
        print("  %4d  %11s  %s%s" % (ln["n"], stamp, _clip(ln["prompt"], 90), rep))

    for ln in lines[:head]:
        show(ln)
    if tail:
        print(c("90", "        …  %d turns  …" % (lines[-tail]["n"] - lines[head]["n"])))
        for ln in lines[-tail:]:
            show(ln)
    final = next((t for t in reversed(turns) if t["replies"]), None)
    if final:
        print("last reply (turn %d): %s" % (final["n"], _clip(final["replies"][-1], 300)))
    print(c("90", _cmd("next: project-manager session %s -t <N>   (one turn in full)   · --files (what it wrote)")
            % _short_sid(e)))


def _show_turns(h, e, turns, a):
    m = re.fullmatch(r"(\d+)(?:-(\d+))?", a.turn.strip())
    if not m:
        sys.exit("-t takes a turn number or a range: -t 12, -t 12-14")
    lo = int(m.group(1))
    hi = int(m.group(2) or lo)
    if not turns:
        sys.exit("this conversation has no turns")
    if not (1 <= lo <= hi <= len(turns)):
        sys.exit("turns run 1-%d" % len(turns))
    if hi - lo >= 5:
        sys.exit("at most 5 turns at a time — each can be long")
    budget_p, budget_r = (None, None) if a.full else (1500, 2500)

    def cut(s, n):
        if n is None or len(s) <= n:
            return s
        return s[:n] + c("90", "\n[… %d more characters — --full]" % (len(s) - n))

    print(c("1", "session %s" % e["sid"]) + c("90", " · %s · %s · %s" % (
        _agent(e), h.name(e.get("root") or h._root(e["cwd"])), _tilde(e["path"]))))
    for t in turns[lo - 1:hi]:
        print("\n" + c("1", "── turn %d of %d · %s ──" % (t["n"], len(turns), _when(t["ts"]))))
        print(c("36", "you:"))
        print(cut(t["prompt"], budget_p))
        reps = t["replies"]
        if not reps:
            print(c("90", "(no reply recorded)")); continue
        # The last message is where the agent landed; the ones before it are its running commentary,
        # so they get a line each and the last gets the space.
        if len(reps) > 1:
            print(c("36", "agent — %d messages; the earlier ones by their first line:" % len(reps)))
            earlier = reps[:-1] if a.full else reps[:-1][-8:]
            if len(reps) - 1 > len(earlier):
                print(c("90", "  · … %d more" % (len(reps) - 1 - len(earlier))))
            for r in earlier:
                print(c("90", "  · ") + (r if a.full else _clip(r.split("\n", 1)[0], 110)))
            print(c("36", "agent — last message:"))
        else:
            print(c("36", "agent:"))
        print(cut(reps[-1], budget_r))
    nav = []
    if lo > 1:
        nav.append("-t %d" % (lo - 1))
    if hi < len(turns):
        nav.append("-t %d" % (hi + 1))
    print(c("90", _cmd("\nnext: project-manager session %s %s") % (_short_sid(e), " | ".join(nav) or "")))


# Where a shell command put things: redirects, tee, -o/--output/--local-dir, and the last argument
# of cp/mv/rsync/ditto. Best effort by construction — it is reading shell, not running it — which is
# why its findings are listed apart and only when the path exists now.
_TOKEN = r"('[^']*'|\"[^\"]*\"|[^\s;|&<>()]+)"
_SHELL_DEST = [re.compile(r"(?:^|[^<>&0-9])>>?\s*" + _TOKEN),
               re.compile(r"\btee\s+(?:-a\s+)?" + _TOKEN),
               re.compile(r"(?:\s-o|--output(?:-dir)?|--local-dir|--out(?:put)?[_-]?dir)[=\s]+" + _TOKEN)]
_SHELL_COPY = re.compile(r"\b(?:cp|mv|rsync|ditto)\s+(?:-\S+\s+)*" + r"(?:" + _TOKEN + r"\s+)+" + _TOKEN)


def _shell_targets(cmd):
    out = []
    for rx in _SHELL_DEST:
        out += [m.group(1) for m in rx.finditer(cmd)]
    out += [m.group(m.lastindex) for m in _SHELL_COPY.finditer(cmd)]
    return [t.strip("'\"") for t in out]


def _usable_path(fp):
    # Template placeholders and globs are not files: a Codex patch built in JS carries `${p}`.
    return (fp and not any(ch in fp for ch in "$`*?{}") and not fp.startswith(("/dev/", "&"))
            and fp.rstrip("/") not in ("", "~", HOME, "/tmp", "/private/tmp", "."))


def _touched(path, src, cwd):
    """(written, read) paths from one transcript's tool calls — the index keeps what was said, not
    what was done, so this reads the file itself.

    Claude: Write / Edit / MultiEdit / NotebookEdit are writes, Read is a read. Codex 0.15x wraps
    every tool in one JS `exec` call, and its edits show up as apply_patch headers inside it —
    `*** Update File: <path>` — so those are matched on the raw line, which also catches older
    Codex versions that called apply_patch directly. Codex reads go through shell commands and are
    not attributed.
    """
    written, read, shell = {}, {}, {}
    def add(d, fp):
        fp = (fp or "").strip()
        if not _usable_path(fp):
            return
        fp = os.path.expanduser(fp)
        if not fp.startswith("/"):
            fp = os.path.normpath(os.path.join(cwd or "/", fp))
        d[fp] = d.get(fp, 0) + 1
    def add_cmd(cmd):
        for t in _shell_targets(cmd or ""):
            add(shell, t)
    try:
        f = open(path, "rb")
    except OSError:
        return written, read, shell
    with f:
        for line in f:
            if src == 0:
                if b'"tool_use"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                for b in (o.get("message") or {}).get("content") or []:
                    if not isinstance(b, dict) or b.get("type") != "tool_use":
                        continue
                    inp = b.get("input") or {}
                    name = b.get("name")
                    if name in ("Write", "Edit", "MultiEdit"):
                        add(written, inp.get("file_path"))
                    elif name == "NotebookEdit":
                        add(written, inp.get("notebook_path"))
                    elif name == "Read":
                        add(read, inp.get("file_path"))
                    elif name == "Bash":
                        add_cmd(inp.get("command"))
            else:
                if b"File: " in line:
                    txt = line.decode("utf-8", "replace")
                    for m in re.finditer(r"\*\*\* (?:Add|Update) File: ([^\n\\\"]+)", txt):
                        add(written, m.group(1))
                if b"exec_command" in line or b'"shell"' in line:
                    try:
                        p = json.loads(line).get("payload") or {}
                    except ValueError:
                        continue
                    body = p.get("input") or p.get("arguments") or ""
                    # exec_command({cmd:"…"}) inside the JS the exec tool runs, or {"command":[…]}.
                    for m in re.finditer(r'cmd:\s*"((?:[^"\\]|\\.)*)"', body if isinstance(body, str) else ""):
                        try:
                            add_cmd(json.loads('"%s"' % m.group(1)))
                        except ValueError:
                            add_cmd(m.group(1))
    return written, read, shell


def _by_dir(paths, dirs=12, per=5):
    """Paths grouped under their directory, busiest first — a list of 300 files is not an answer,
    the four folders they went into is."""
    groups = {}
    for fp, n in paths.items():
        groups.setdefault(os.path.dirname(fp), []).append((n, os.path.basename(fp)))
    # Scratch folders last: a session's throwaway probes outnumber its deliverables, and the
    # deliverables are what someone coming back to the work is looking for.
    order = sorted(groups.items(), key=lambda kv: ((kv[0] + "/").startswith(SCRATCH_PREFIXES),
                                                   -sum(n for n, _ in kv[1])))
    out = []
    for d, files in order[:dirs]:
        files.sort(reverse=True)
        names = ", ".join(b for _, b in files[:per]) + (" …+%d" % (len(files) - per) if len(files) > per else "")
        out.append("  %s  %s" % (_tilde(d) + "/", c("90", "(%d) %s" % (len(files), names))))
    if len(order) > dirs:
        out.append(c("90", "  … %d more folders" % (len(order) - dirs)))
    return out


def _show_files(h, e):
    paths = [e] + [x for x in h.files.values() if x.get("parent_path") == e["path"]]
    written, read, shell = {}, {}, {}
    for x in paths:
        if x["size"] is None:
            continue
        w, r, sh = _touched(x["path"], x["src"], x["cwd"] or e["cwd"])
        for acc, got in ((written, w), (read, r), (shell, sh)):
            for fp, n in got.items():
                acc[fp] = acc.get(fp, 0) + n
    subs = len(paths) - 1
    print("%s %s · %s · %s" % (c("1", "files"), e["sid"], _agent(e),
                               "incl. %s" % _n(subs, "subagent thread") if subs else "no subagent threads"))
    if e["size"] is None:
        print(c("33", "  the transcript is deleted — only what was said survives, not what was done"))
        return
    gone = sum(1 for fp in written if not os.path.exists(fp))
    print("written or edited: %s%s" % (_n(len(written), "file"),
                                       c("90", " (%d no longer exist)" % gone) if gone else ""))
    for ln in _by_dir(written):
        print(ln)
    shell = {fp: n for fp, n in shell.items() if fp not in written and os.path.exists(fp)}
    if shell:
        print("put there by shell commands (best effort, existing paths only): %s" % _n(len(shell), "path"))
        for ln in _by_dir(shell, dirs=8, per=4):
            print(ln)
    if read:
        print("read: %s" % _n(len(read), "file"))
        for ln in _by_dir(read, dirs=8, per=4):
            print(ln)
    elif e["src"] == 1:
        print(c("90", "read: not tracked for Codex (it reads through shell commands)"))
    print(c("90", _cmd("next: project-manager cat <file> to read one, or project-manager session %s -t <N> for why")
            % _short_sid(e)))


def _memory_dirs(h, root):
    """Claude's per-project memory folders for a project: one per transcript folder (slug) that its
    conversations live in. Notes a previous agent left about the project — often the fastest way
    back into it."""
    dirs = []
    for e in h.sessions.values():
        if e["root"] != root or e["src"] != 0:
            continue
        m = os.path.join(os.path.dirname(e["path"]), "memory")
        if m not in dirs and os.path.isdir(m):
            dirs.append(m)
    return dirs


def _memory_notes(d):
    notes = []
    for n in sorted(os.listdir(d)):
        if not n.endswith(".md") or n == "MEMORY.md":
            continue
        try:
            with open(os.path.join(d, n), errors="replace") as f:
                head = f.read(4000)
        except OSError:
            continue
        name = re.search(r"^name:\s*(.+)$", head, re.M)
        desc = re.search(r"^description:\s*(.+)$", head, re.M)
        notes.append((n, (name.group(1) if name else n[:-3]).strip().strip('"'),
                      (desc.group(1) if desc else "").strip().strip('"').replace('\\"', '"')))
    return notes


def cmd_memory(a):
    h = _History()
    roots = {e["root"] for e in h.sessions.values()}
    if a.project:
        root, note = _resolve_project(h, a.project, roots)
        if note:
            print(c("33", note))
    else:
        root = _own_root(h)
    dirs = _memory_dirs(h, root)
    if not dirs:
        print("no memory notes for %s" % h.name(root)); return
    for d in dirs:
        notes = _memory_notes(d)
        print("%s — %s" % (c("1", h.name(root)), _tilde(d) + "/"))
        for fn, name, desc in notes:
            print("  %-26s %s" % (_clip(name, 26), _clip(desc, 110)))
    print(c("90", _cmd("next: read one — project-manager cat <folder>/<name>.md (they are short)")))


def cmd_cat(a):
    """A file, or a folder's listing, on the machine -u names.

    Here it is only `cat`/`ls`. It exists for the other machine: history hands over paths — memory
    notes, the files a session wrote, transcripts — and without this, following one from another
    Mac ends at a path you cannot open. Capped, and binary files are described rather than dumped,
    because the output travels back as JSON.
    """
    p = os.path.abspath(os.path.expanduser(a.path))
    if os.path.isdir(p):
        try:
            names = sorted(os.listdir(p), key=str.lower)
        except OSError as e:
            sys.exit("cannot list %s: %s" % (_tilde(p), e.strerror))
        dirs = [n for n in names if os.path.isdir(os.path.join(p, n))]
        files = [n for n in names if n not in set(dirs)]
        print("%s  %s, %s" % (c("1", _tilde(p) + "/"), _n(len(dirs), "folder"), _n(len(files), "file")))
        for n in (dirs + files)[:a.max_entries]:
            fp = os.path.join(p, n)
            if n in dirs:
                print("  %8s  %s/" % ("", n))
            else:
                try:
                    stt = os.stat(fp)
                    print("  %8s  %s  %s" % (short_bytes(stt.st_size),
                                             time.strftime("%m-%d %H:%M", time.localtime(stt.st_mtime)), n))
                except OSError:
                    print("  %8s  %s" % ("?", n))
        more = len(names) - a.max_entries
        if more > 0:
            print(c("90", "  … %d more (--max-entries %d)" % (more, len(names))))
        return
    try:
        size = os.path.getsize(p)
        with open(p, "rb") as f:
            data = f.read(a.max)
    except OSError as e:
        sys.exit("cannot read %s: %s" % (_tilde(p), e.strerror or e))
    if b"\0" in data[:8192]:
        sys.exit("%s is binary (%s) — not printed" % (_tilde(p), short_bytes(size)))
    text = data.decode("utf-8", "replace")
    if a.lines:
        text = "".join(text.splitlines(True)[:a.lines])
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")
    if size > len(data) and not a.lines:
        print(c("33", "… cut at %s of %s (--max BYTES for more)" % (short_bytes(len(data)), short_bytes(size))),
              file=sys.stderr)


def _is_cjk(ch):
    o = ord(ch)
    return (0x3400 <= o <= 0x4DBF or 0x4E00 <= o <= 0x9FFF or 0xF900 <= o <= 0xFAFF
            or 0x3040 <= o <= 0x30FF or 0xAC00 <= o <= 0xD7AF or 0x20000 <= o <= 0x2FA1F)

def _fts_query(q):
    """SearchIndex.matchExpression, in Python: terms AND-ed, each CJK character its own token, each
    term an adjacent phrase — FTS5's tokenizer swallows a whole Han run otherwise, and 搜索 would
    never match 搜索能力."""
    terms, buf, quoted = [], "", False
    for ch in q:
        if ch == '"':
            if quoted and buf.strip():
                terms.append(buf.strip())
                buf = ""
            quoted = not quoted
        elif ch.isspace() and not quoted:
            if buf.strip():
                terms.append(buf.strip())
            buf = ""
        else:
            buf += ch
    if buf.strip():
        terms.append(buf.strip())
    parts = []
    for term in terms:
        seg = "".join(" %s " % ch if _is_cjk(ch) else ch for ch in term)
        toks = [t.replace('"', "") for t in seg.split()]
        toks = [t for t in toks if t]
        if toks:
            parts.append('"%s"' % " ".join(toks))
    return " AND ".join(parts), terms


def _snippet(body, terms, width=44):
    flat = " ".join(body.split())
    low = flat.lower()
    at = min((i for i in (low.find(t.lower()) for t in terms) if i >= 0), default=0)
    lo = max(0, at - width)
    hi = min(len(flat), at + width + max((len(t) for t in terms), default=0))
    return ("…" if lo else "") + flat[lo:hi] + ("…" if hi < len(flat) else "")


def cmd_search(a):
    h = _History()
    match, terms = _fts_query(" ".join(a.words))
    if not match:
        sys.exit("nothing to search for")
    sql = ("SELECT m.id, m.role, m.ts, m.path, m.body FROM msg_fts JOIN msg m ON m.id = msg_fts.rowid "
           "WHERE msg_fts MATCH ?")
    args = [match]
    if a.prompts != a.replies:
        sql += " AND m.role = ?"
        args.append(0 if a.prompts else 1)
    if a.project:
        roots = {e["root"] for e in h.sessions.values()}
        root, note = _resolve_project(h, a.project, roots)
        if note:
            print(c("33", note))
        paths = [p for p, e in h.files.items()
                 if h._root(e["cwd"]) == root]
        if not paths:
            sys.exit("no conversations in %s" % h.name(root))
        sql += " AND m.path IN (%s)" % ",".join("?" * len(paths))
        args += paths
    sql += " ORDER BY m.ts DESC LIMIT 3000"
    groups = {}
    for mid, role, ts, path, body in h.db.execute(sql, args):
        if role == 0 and _injected(body):
            continue
        e = h.files.get(path)
        if e is None:
            continue
        home = h.files.get(e.get("parent_path") or path, e)
        if not a.all and home["kind"] == "exec":
            continue
        g = groups.setdefault(home["path"], {"e": home, "hits": [], "last": _epoch(ts)})
        g["hits"].append((mid, role, ts, path, body))
    if not groups:
        print("no conversation mentions %s" % " ".join(a.words)); return
    total = sum(len(g["hits"]) for g in groups.values())
    order = sorted(groups.values(), key=lambda g: -(g["last"] or 0))
    print("%s — %d hit%s in %d conversation%s, newest first%s" % (
        c("1", "search %s" % " ".join(a.words)), total, "" if total == 1 else "s",
        len(groups), "" if len(groups) == 1 else "s",
        " (showing %d)" % a.n if len(groups) > a.n else ""))
    for g in order[:a.n]:
        e = g["e"]
        title = _card_title(h, e.get("card"))
        card = ('  "%s"' % _clip(title, 30)) if title else ""
        print("\n %s  %-6s %-18s %s  %d hit%s%s" % (
            c("1", _short_sid(e)), _agent(e), _clip(h.name(h._root(e["cwd"])), 18), _when(g["last"]),
            len(g["hits"]), "" if len(g["hits"]) == 1 else "s", card))
        for mid, role, ts, path, body in g["hits"][:2]:
            if path != e["path"]:
                where = c("90", "subagent")
            else:
                n = h.db.execute(
                    "SELECT COUNT(*) FROM msg WHERE path = ? AND role = 0 AND id %s ? AND %s"
                    % ("<=" if role == 0 else "<", _INJECTED_SQL),
                    [path, mid] + _INJECTED_ARGS).fetchone()[0]
                where = "t%d" % n
            who = "you:  " if role == 0 else "agent:"
            print("    %-8s %s %s" % (where, c("36", who), _snippet(body, terms)))
    print(c("90", _cmd("\nnext: project-manager session <id> -t <N>   (the turn a hit is in)")))


def main():
    p = argparse.ArgumentParser(prog="project-manager", description="Control a running FleetView instance.")
    p.add_argument("-u", "--url", help="target another FleetView (same as FLEETVIEW_URL)")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("peers", help="find FleetView instances on this network")
    s.add_argument("--ports", help="ports to probe (default 8080,8081,8082)")
    # 0.6s used to miss a live instance on a quiet LAN — a peer that answers slowly reads as "no
    # peers at all", which is the one wrong answer this command must not give.
    s.add_argument("--timeout", type=float, default=1.5)
    s.add_argument("--jobs", type=int, default=128)
    s.set_defaults(fn=cmd_peers)
    s = sub.add_parser("whoami", help="which terminal/project this agent is running in")
    s.add_argument("-p", "--project", dest="project_only", action="store_true",
                   help="print only the project name")
    s.add_argument("--path", dest="path_only", action="store_true",
                   help="print only the project's directory")
    s.add_argument("--id", dest="id_only", action="store_true", help="print only this terminal's id")
    s.set_defaults(fn=cmd_whoami)
    s = sub.add_parser("ls", help="list terminals")
    s.add_argument("-m", "--marked", action="store_true", help="only terminals you marked")
    s.add_argument("-p", "--project", help="only this project (name substring or id prefix)")
    s.add_argument("-g", "--group", action="store_true", help="group by project")
    s.set_defaults(fn=cmd_ls)
    w = sub.add_parser("watch", help="live list"); w.add_argument("-n", type=float, default=2.0)
    w.add_argument("-m", "--marked", action="store_true", help="only terminals you marked")
    w.add_argument("-p", "--project", help="only this project (name substring or id prefix)")
    w.add_argument("-g", "--group", action="store_true", help="group by project")
    w.set_defaults(fn=cmd_watch)
    for name, fn, hlp in (("show", cmd_show, "one terminal: status, cwd, transcript, recent output"),
                          ("tail", cmd_tail, "a terminal's recent output only")):
        s = sub.add_parser(name, help=hlp); s.add_argument("sel"); s.add_argument("-l", "--lines", type=int, default=200); s.set_defaults(fn=fn)
    s = sub.add_parser("send", help="inject a prompt"); s.add_argument("sel"); s.add_argument("-N", "--no-enter", action="store_true"); s.add_argument("text", nargs="+"); s.set_defaults(fn=cmd_send)
    s = sub.add_parser("key", help="send a key"); s.add_argument("sel"); s.add_argument("key"); s.set_defaults(fn=cmd_key)
    s = sub.add_parser("choose", help="answer a numbered menu"); s.add_argument("sel"); s.add_argument("n"); s.set_defaults(fn=cmd_choose)
    s = sub.add_parser("check", help="find error-terminated sessions"); s.add_argument("sel", nargs="?"); s.set_defaults(fn=cmd_check)
    s = sub.add_parser("ask", help="BTW side-query (forked; does not touch the live session)"); s.add_argument("sel"); s.add_argument("text", nargs="+"); s.set_defaults(fn=cmd_ask)
    s = sub.add_parser("log", help="locate the agent transcript file"); s.add_argument("sel")
    s.add_argument("-f", "--follow", action="store_true"); s.add_argument("-c", "--cat", action="store_true")
    s.add_argument("-p", "--path", dest="path_only", action="store_true", help="print only the path")
    s.add_argument("--bytes-from", type=int, help=argparse.SUPPRESS)   # /pm plumbing, see _log_remote
    s.add_argument("--tailing", action="store_true", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_log)
    s = sub.add_parser("new", help="open a terminal in a project")
    s.add_argument("sel", help="project")
    s.add_argument("label", nargs="?", help="label the new terminal (same as -n)")
    s.add_argument("-n", "--name", help="label the new terminal")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--claude", action="store_true", help="start `%s` in it" % CLAUDE_CMD)
    g.add_argument("-c", "--cmd", help="run this command in it instead")
    s.set_defaults(fn=cmd_new)
    s = sub.add_parser("subagent", help="open a new agent terminal and give it a task")
    s.add_argument("text", nargs="+", help="the task to hand it")
    s.add_argument("-p", "--project", help="project to open it in (default: your own)")
    s.add_argument("-n", "--name", help="label the card (default: the task)")
    s.add_argument("--codex", action="store_true", help="use codex instead of claude")
    s.add_argument("--no-wait", action="store_true",
                   help="open the agent but do not wait for it or send the task")
    s.add_argument("--id", dest="id_only", action="store_true",
                   help="print only the new terminal's uuid on stdout (status goes to stderr)")
    s.set_defaults(fn=cmd_subagent)
    s = sub.add_parser("rename", help="relabel a terminal")
    s.add_argument("sel"); s.add_argument("text", nargs="+"); s.set_defaults(fn=cmd_rename)
    s = sub.add_parser("rm", help="remove a terminal (kills its session)"); s.add_argument("sel"); s.set_defaults(fn=cmd_rm)
    s = sub.add_parser("restore", help="bring a conversation back by its session id: its card, "
                                       "and the agent resumed in it")
    s.add_argument("sid", help="the conversation's session id (Claude or Codex), or its first 8+ characters")
    s.add_argument("--no-wait", action="store_true", help="do not wait for the agent to come back up")
    s.set_defaults(fn=cmd_restore)
    s = sub.add_parser("projects", help="history L0: projects by last activity (this Mac)")
    s.add_argument("-n", type=int, default=12, help="how many projects (default 12)")
    s.add_argument("--days", type=int, help="only projects active in the last N days")
    s.add_argument("-a", "--all", action="store_true",
                   help="include scratch dirs and non-interactive runs (claude -p, codex exec)")
    s.set_defaults(fn=cmd_projects)
    s = sub.add_parser("history", help="history L1: one project's conversations (this Mac)")
    s.add_argument("project", nargs="?", help="project name/path (default: your own)")
    s.add_argument("-n", type=int, default=10, help="how many conversations (default 10)")
    s.add_argument("-a", "--all", action="store_true", help="include non-interactive runs")
    s.set_defaults(fn=cmd_history)
    s = sub.add_parser("session", help="history L2/L3: one conversation's turns, or one turn")
    s.add_argument("sel", help="session id prefix, FleetView card id, or transcript path")
    s.add_argument("-t", "--turn", help="show turn N (or N-M, up to 5) in full")
    s.add_argument("--all", action="store_true", help="list every turn, not just the first and last")
    s.add_argument("--first", type=int, default=3, help=argparse.SUPPRESS)
    s.add_argument("--last", type=int, default=12, help=argparse.SUPPRESS)
    s.add_argument("--full", action="store_true", help="with -t: no length limits")
    s.add_argument("--files", action="store_true",
                   help="the files it wrote/edited (and, for Claude, read), grouped by folder")
    s.set_defaults(fn=cmd_session)
    s = sub.add_parser("memory", help="notes earlier agents left about a project (Claude memory)")
    s.add_argument("project", nargs="?", help="project name/path (default: your own)")
    s.set_defaults(fn=cmd_memory)
    s = sub.add_parser("open", help="put a ~/PycharmProjects folder on the board (like the web's 📂)")
    s.add_argument("sel", help="folder name (fuzzy) or path")
    s.add_argument("-t", "--terminal", action="store_true", help="also open a terminal in it")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--claude", action="store_true", help="…and start `%s` in it" % CLAUDE_CMD)
    g.add_argument("--codex", action="store_true", help="…and start `%s` in it" % CODEX_CMD)
    s.add_argument("-n", "--name", help="label the terminal")
    s.set_defaults(fn=cmd_open)
    s = sub.add_parser("search", help="find conversations that mention something (this Mac)")
    s.add_argument("words", nargs="+", help='words to find (AND-ed; "quote a phrase")')
    s.add_argument("-p", "--project", help="only this project")
    s.add_argument("-n", type=int, default=8, help="how many conversations (default 8)")
    s.add_argument("--prompts", action="store_true", help="only what you typed")
    s.add_argument("--replies", action="store_true", help="only what agents answered")
    s.add_argument("-a", "--all", action="store_true", help="include non-interactive runs")
    s.set_defaults(fn=cmd_search)
    s = sub.add_parser("cat", help="print a file, or list a folder (on the -u machine)")
    s.add_argument("path")
    s.add_argument("-n", "--lines", type=int, help="only the first N lines")
    s.add_argument("--max", type=int, default=1 << 20, help="bytes to read at most (default 1 MB)")
    s.add_argument("--max-entries", type=int, default=400, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_cat)
    s = sub.add_parser("notes", help="the shared Notes list / web quick-commands")
    s.add_argument("action", nargs="?", choices=("ls", "add", "rm"), help="default: ls")
    s.add_argument("rest", nargs="*", help="text to add, or which note to remove")
    s.add_argument("-f", "--filter", help="only notes containing this (ls)")
    s.add_argument("-p", "--plain", action="store_true", help="raw text only, for copying (ls)")
    s.set_defaults(fn=cmd_notes)
    a = p.parse_args()
    if a.url:
        global BASE
        BASE = a.url.rstrip("/")
    if is_remote() and a.cmd in REMOTE_RUN and a.cmd != "log":   # log mixes both; see _log_remote
        argv = _sub_argv(sys.argv[1:])
        if a.cmd in ("history", "memory") and not a.project:
            # "Your project" is decided here, where you are; over there it would be decided by
            # FleetView's own working directory, which is no project at all.
            argv.append(own_project_name())
        forward(argv)
    a.fn(a)

if __name__ == "__main__":
    main()
